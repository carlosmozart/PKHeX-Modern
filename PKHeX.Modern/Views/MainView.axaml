<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PKHeX.Modern.Views"
             xmlns:vm="using:PKHeX.Modern.ViewModels"
             xmlns:local="using:PKHeX.Modern"
             xmlns:controls="using:PKHeX.Modern.Controls"
             x:Class="PKHeX.Modern.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}"
             DragDrop.AllowDrop="True">
  <!-- Interface principal: a mesma no desktop (dentro de MainWindow) e no Android (vista unica). -->

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
  </UserControl.KeyBindings>

  <Grid ColumnDefinitions="232,*,Auto" RowDefinitions="*,Auto">

    <!-- Barra lateral -->
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0" Padding="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="PKHeX" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
            <TextBlock Text="Modern" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
          </StackPanel>
          <!-- Primario so sem save aberto; com save, o primario da tela e o Salvar do rodape (Salvar como fica na seta dele) -->
          <Button Classes.accent="{Binding !HasSave}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="Abrir save..." Click="OnOpen" ToolTip.Tip="Ctrl+O" />
          <Button Classes="ghost small" Command="{Binding OpenLastCommand}" IsVisible="{Binding ShowLastSaveLink}"
                  ToolTip.Tip="{Binding Settings.LastSavePath}">
            <TextBlock Text="{Binding LastSaveName, StringFormat='↺  Último: {0}'}" TextTrimming="CharacterEllipsis" />
          </Button>
          <Border Classes="card" Padding="10,8" Margin="0,6,0,4" IsVisible="{Binding HasSave}">
            <StackPanel Spacing="2">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,2">
                <Border Classes="gameBadge" Width="42" Height="42" Background="{Binding GameArt.Background}"
                        ToolTip.Tip="{Binding GameName}">
                  <Viewbox>
                    <Panel Width="100" Height="100">
                      <Image Source="{Binding GameArt.Sprite}" IsVisible="{Binding !GameArt.IsDual}" />
                      <Image Source="{Binding GameArt.Sprite}" IsVisible="{Binding GameArt.IsDual}" Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <Image Source="{Binding GameArt.Sprite2}" IsVisible="{Binding GameArt.IsDual}" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Panel>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GameName}" />
                  <TextBlock Text="{Binding TrainerInfo}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TrainerInfo}" />
                </StackPanel>
              </Grid>
              <Button Classes="ghost unsavedLink" Margin="-8,2,0,-4" IsVisible="{Binding IsDirty}" Command="{Binding ShowPendingCommand}"
                      ToolTip.Tip="Ver a lista e salvar (Ctrl+S grava o arquivo do save)">
                <TextBlock Text="{Binding PendingText}" Classes="unsaved" FontSize="11" TextDecorations="Underline" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <!-- Atualizacao: aviso → baixando → reiniciar -->
          <Button Classes="accent small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6"
                  IsVisible="{Binding Help.ShowInstallButton}" Content="{Binding Help.UpdateBanner}" Command="{Binding Help.InstallUpdateCommand}"
                  ToolTip.Tip="Mostra as novidades antes de atualizar (vale ao reiniciar)" />
          <Button Classes="accent small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6"
                  IsVisible="{Binding Help.ShowLinkBanner}" Content="{Binding Help.UpdateBanner}" Command="{Binding Help.OpenLatestCommand}"
                  ToolTip.Tip="{Binding Help.UpdateText}" />
          <StackPanel Spacing="4" Margin="0,0,0,6" IsVisible="{Binding Help.IsDownloading}">
            <TextBlock Text="{Binding Help.DownloadText}" Classes="muted" FontSize="11" />
            <ProgressBar Value="{Binding Help.DownloadProgress}" Maximum="100" Height="4" MinHeight="4" />
          </StackPanel>
          <Button Classes="accent small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,6"
                  IsVisible="{Binding Help.IsReadyToRestart}" Content="{Binding Help.RestartText}" Command="{Binding Help.RestartCommand}"
                  ToolTip.Tip="A versão nova já está instalada. Reinicia o app (pergunta antes se houver alterações não salvas)" />
          <!-- Modo legal: cartao clicavel numa linha (verde = ligado, ambar = desligado) -->
          <!-- Modo Hardcore: no lugar do modo legal (sem edicao, o modo legal nao importa); clique desliga -->
          <Button Classes="hardcoreCard" IsVisible="{Binding Hardcore}" Margin="0,0,0,4" Command="{Binding TurnOffHardcoreCommand}"
                  ToolTip.Tip="Ligado: nada de editar dados (desafios e RetroAchievements). Mover, trocar e soltar Pokémon continuam. Clique para desligar.">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="🔒" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="hardcoreTitle" Text="Modo Hardcore" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="legalState" Text="Ligado" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <ToggleButton Classes="legalCard" IsChecked="{Binding LegalMode}" Margin="0,0,0,4" IsVisible="{Binding !Hardcore}"
                        ToolTip.Tip="Ligado: o editor só mostra opções legais (golpes que o Pokémon aprende, bolas do encontro, espécies do jogo), desfaz mudanças que o deixariam ilegal e só aplica Pokémon legal. Clique para ligar ou desligar.">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <Viewbox Width="17" Height="19" VerticalAlignment="Center">
                <Panel>
                  <Path Classes="legalShield" Data="M12,1 L21,4.5 V11 C21,16.5 17.2,21.2 12,23 C6.8,21.2 3,16.5 3,11 V4.5 Z" />
                  <Path Classes="legalMark" Data="M7.5,12 L10.8,15.3 L16.8,8.8" StrokeThickness="2.4"
                        StrokeLineCap="Round" StrokeJoin="Round" IsVisible="{Binding LegalMode}" />
                  <Path Classes="legalMark" Data="M12,7 V13.5 M12,17 V17.2" StrokeThickness="2.6"
                        StrokeLineCap="Round" IsVisible="{Binding !LegalMode}" />
                </Panel>
              </Viewbox>
              <TextBlock Grid.Column="1" Classes="legalTitle" Text="Modo legal" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="legalState" Text="Ligado" IsVisible="{Binding LegalMode}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Classes="legalState" Text="Desligado" IsVisible="{Binding !LegalMode}" VerticalAlignment="Center" />
            </Grid>
          </ToggleButton>
          <!-- Ajuda, atalhos, claro/escuro e preferencias (tema, cor, idioma, abrir ultimo) numa linha -->
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
            <Button Classes="ghost small helpNav" Classes.selected="{Binding IsHelpOpen}" HorizontalAlignment="Stretch" Content="Ajuda" Command="{Binding OpenHelpCommand}"
                    ToolTip.Tip="Todas as funções explicadas, o que mudou em cada versão e Sobre (F1)" />
            <Button Grid.Column="1" Classes="ghost small" Content="⌨" IsVisible="{x:Static local:App.ShowShortcuts}"
                    ToolTip.Tip="Atalhos do teclado&#10;Ctrl+F buscar · Q / E trocar página&#10;Esc voltar · Del excluir&#10;Ctrl+clique seleciona vários&#10;Ctrl+Z desfazer · Ctrl+Y refazer&#10;Ctrl+O abrir · Ctrl+S salvar" />
            <Button Grid.Column="2" Classes="ghost small" Content="◐" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Alternar tema claro/escuro" />
            <Button Grid.Column="3" x:Name="PrefsButton" Classes="ghost small" Content="⚙" ToolTip.Tip="Aparência e preferências: tema, cor de destaque, idioma e abrir o último save ao iniciar">
              <Button.Flyout>
                <Flyout Placement="RightEdgeAlignedBottom">
                  <ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="4" Width="250" Margin="4">
                    <TextBlock Text="TEMA" Classes="section" Margin="0" />
                    <ItemsControl ItemsSource="{Binding ThemeOptions}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                          <Button Classes="ghost small" Margin="2" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  ToolTip.Tip="{Binding Tip}" Command="{Binding SelectCommand}">
                            <StackPanel Spacing="3">
                              <Image Source="{Binding Preview}" Stretch="Uniform" />
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Header}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <controls:TouchHint Grid.Column="1" Description="{Binding Tip}"
                                  IsVisible="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).IsTouchUI}" />
                              </Grid>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="TAMANHO DOS SPRITES" Classes="section" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding SpriteSizeOptions}" SelectedIndex="{Binding SpriteSizeIndex}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Tamanho dos Pokémon nas caixas, no bank, no outro save e na Pokédex" />
                    <TextBlock Text="PAPEL DE PAREDE DAS CAIXAS" Classes="section" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding WallpaperIntensityOptions}" SelectedIndex="{Binding WallpaperIntensityIndex}" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Muda só a exibição; o papel de parede do jogo é preservado." FontSize="11" Classes="muted" TextWrapping="Wrap" />
                    <CheckBox Content="Cor do tipo nos cartões" IsChecked="{Binding SlotTypeColor}" Margin="0,4,0,0"
                              ToolTip.Tip="Tinge o fundo de cada Pokémon nas caixas, na equipe e no bank com a cor dos tipos dele" />
                    <TextBlock Text="FONTE" Classes="section" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding FontOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontOptionViewModel">
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4"
                                  Content="{Binding Header}" FontFamily="{Binding Family}" ToolTip.Tip="{Binding Tip}" Command="{Binding SelectCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="COR DE DESTAQUE" Classes="section" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding AccentOptions}" Margin="6,4,0,4" ClipToBounds="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel ItemSpacing="7" LineSpacing="7" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentOptionViewModel">
                          <Button Classes="accentDot" Classes.selected="{Binding IsSelected}" Background="{Binding Brush}"
                                  ToolTip.Tip="{Binding Name}" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SetAccentCommand}"
                                  CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="IDIOMA" Classes="section" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding LanguageOptions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                          <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Content="{Binding Header}" Command="{Binding SelectCommand}"
                                  ToolTip.Tip="Idioma da interface (vale ao reiniciar). Nomes do jogo continuam em inglês." />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="Abrir último save ao iniciar" FontSize="12" Margin="0,8,0,0" IsChecked="{Binding OpenLastSaveOnStartup}" />
                    <CheckBox Content="Oferecer legalizar ao clicar num ilegal" FontSize="12" IsChecked="{Binding AskLegalizeOnClick}"
                              ToolTip.Tip="Ao clicar num Pokémon ilegal, mostra a prévia do Legalizar. Desligado, o Pokémon só abre no editor (o botão Legalizar continua lá)." />
                    <CheckBox Content="Modo Hardcore (só mover Pokémon)" FontSize="12" IsChecked="{Binding Hardcore}"
                              ToolTip.Tip="Para desafios (Nuzlocke) e RetroAchievements: desliga toda edição de dados. O editor só mostra os dados e Treinador, Mochila, Jogo e Edição em lote saem da barra lateral; mover, trocar, soltar e ordenar continuam." />
                  </StackPanel>
                  </ScrollViewer>
                </Flyout>
              </Button.Flyout>
            </Button>
          </Grid>
        </StackPanel>

        <!-- Busca global (Ctrl+F) -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6" IsVisible="{Binding HasSave}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="SearchBox" Text="{Binding SearchText}" Watermark="🔍  Buscar (Ctrl+F)"
                     ToolTip.Tip="Espécie, apelido, golpe ou item em todas as caixas e na equipe. Também: shiny, ovo" />
            <Button Grid.Column="1" Classes="ghost small" Content="✕" Margin="4,0,0,0" Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearch}" ToolTip.Tip="Limpar busca" />
          </Grid>
          <TextBlock Text="{Binding SearchSummary}" Classes="muted" FontSize="11" IsVisible="{Binding HasSearch}" />
          <ScrollViewer MaxHeight="260" IsVisible="{Binding HasSearch}">
            <ItemsControl ItemsSource="{Binding SearchResults}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchHitViewModel">
                  <Button Classes="ghost searchHit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).GoToSearchHitCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Reason}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Image Source="{Binding Sprite}" Width="28" Height="28" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <Button DockPanel.Dock="Top" Classes="navHome" Classes.selected="{Binding IsHomeActive}" IsVisible="{Binding HasSave}"
                Command="{Binding GoHomeCommand}" ToolTip.Tip="Tela inicial do save: equipe, atalhos e saves recentes (Ctrl+0)">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <controls:LineIcon Kind="⌂" Width="18" Height="18" Margin="1,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Início" />
            <TextBlock Grid.Column="2" Text="Ctrl+0" Classes="muted navShortcut" FontSize="10" VerticalAlignment="Center" IsVisible="{x:Static local:App.ShowShortcuts}" />
          </Grid>
        </Button>
        <!-- Sem save aberto: os saves da pasta (Save Manager) para abrir com um clique -->
        <DockPanel DockPanel.Dock="Top" IsVisible="{Binding ShowSidebarSaves}" Margin="0,10,0,0">
          <TextBlock DockPanel.Dock="Top" Text="SEUS SAVES" Classes="section" Margin="4,0,0,6" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SaveManager.Entries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveEntryViewModel">
                  <Button Classes="ghost sideSave" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SaveManager.OpenCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding Path}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Border Classes="gameBadge" Width="30" Height="30" CornerRadius="6" Background="{Binding Art.Background}">
                        <Viewbox Margin="1">
                          <Panel Width="100" Height="100">
                            <Image Source="{Binding Art.Sprite}" IsVisible="{Binding !Art.IsDual}" />
                            <Image Source="{Binding Art.Sprite}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Image Source="{Binding Art.Sprite2}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                          </Panel>
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Game}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FileName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        <!-- Recorte explicito: com a escala do Android, a lista rolada desenhava o item de cima por baixo do "Inicio" -->
        <Border ClipToBounds="True" IsVisible="{Binding HasSave}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,4,0,0">
          <ListBox Classes="nav" Classes.dimmed="{Binding IsHelpOpen}" IsVisible="{Binding HasSave}" ItemsSource="{Binding Pages}"
                   SelectedItem="{Binding CurrentPage}" Background="Transparent">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:PageViewModel">
                <Setter Property="Margin" Value="{Binding NavMargin}" />
              </Style>
            </ListBox.Styles>
            <!-- Sem virtualizacao: sao poucas paginas, e no Android a linha reciclada ficava desenhada por cima ao rolar -->
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PageViewModel">
                <Panel>
                  <!-- Titulo do grupo no espaco acima da linha (NavMargin); fora do realce da selecao e sem receber clique -->
                  <Canvas IsVisible="{Binding IsGroupStart}" IsHitTestVisible="False" VerticalAlignment="Top">
                    <TextBlock Text="{Binding GroupHeader}" Classes="section navGroup" Canvas.Left="-8" Canvas.Top="-22" />
                  </Canvas>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <controls:LineIcon Kind="{Binding Icon}" Width="18" Height="18" Margin="1,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="muted navShortcut" FontSize="10" VerticalAlignment="Center"
                               IsVisible="{x:Static local:App.ShowShortcuts}" />
                  </Grid>
                </Panel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </Border>

    <!-- Conteudo -->
    <DockPanel Grid.Column="1" Margin="24">
      <!-- Abas dos saves abertos (cada save mantem alteracoes, desfazer, caixa e pagina) -->
      <Border DockPanel.Dock="Top" Classes="saveTabsBar" IsVisible="{Binding HasTabs}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ItemsControl ItemsSource="{Binding OpenSaves}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveTabViewModel">
                  <Button Classes="saveTab" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tooltip}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                      <Border Classes="gameBadge" Width="26" Height="26" CornerRadius="6" Background="{Binding Art.Background}">
                        <Viewbox Margin="1">
                          <Panel Width="100" Height="100">
                            <Image Source="{Binding Art.Sprite}" IsVisible="{Binding !Art.IsDual}" />
                            <Image Source="{Binding Art.Sprite}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Image Source="{Binding Art.Sprite2}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                          </Panel>
                        </Viewbox>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Game}" Classes="muted" FontSize="10" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="●" Classes="tabDirty" IsVisible="{Binding IsDirty}" VerticalAlignment="Center"
                                 ToolTip.Tip="Alterações não salvas" />
                      <Button Grid.Column="3" Classes="tabClose" Content="✕" Command="{Binding CloseCommand}"
                              ToolTip.Tip="Fechar este save (Ctrl+W)" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="tabNew" Content="+" Command="{Binding NewTabCommand}"
                    ToolTip.Tip="Abrir outro save numa aba nova (escolha no Save Manager, Ctrl+O ou arraste o arquivo). Ctrl+Tab troca de aba." />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <!-- Barra do toque (Selecionar/Mover) abaixo das abas: as abas sobem para o espaço de cima (margem -12) e, com a barra
           antes delas, ficavam por cima dela no celular -->
      <WrapPanel DockPanel.Dock="Top" IsVisible="{Binding ShowTouchToolbar}" ItemSpacing="6" LineSpacing="6" Margin="0,0,0,8">
        <ToggleButton Content="☐ Selecionar" IsChecked="{Binding TouchSelectionMode}" ToolTip.Tip="Liga a seleção por toque: cada toque marca ou desmarca um Pokémon, em vez de abrir o editor." />
        <ComboBox ItemsSource="{Binding TouchDropOptions}" SelectedIndex="{Binding TouchDropIndex}" MinWidth="125" />
        <controls:TouchHint Description="{Binding TouchDropTip}" />
        <TextBlock Text="{Binding MarkedText}" VerticalAlignment="Center" IsVisible="{Binding TouchSelectionMode}" />
        <ComboBox ItemsSource="{Binding SelectionBoxOptions}" SelectedIndex="{Binding SelectionBoxIndex}" Width="120" IsVisible="{Binding HasMarks}" />
        <Button Content="Para a caixa" Command="{Binding MoveTouchSelectionCommand}" IsVisible="{Binding HasMarks}" />
        <Button Content="Para o Bank" Command="{Binding BankTouchSelectionCommand}" IsVisible="{Binding HasMarks}" />
        <Button Content="Edição em lote" Command="{Binding BatchTouchSelectionCommand}" IsVisible="{Binding HasMarks}" />
        <Button Content="Excluir selecionados" Command="{Binding DeleteMarkedCommand}" IsVisible="{Binding HasMarks}" />
      </WrapPanel>
      <Panel>
      <!-- Sem save aberto: o Save Manager e a tela inicial -->
      <ContentControl Content="{Binding SaveManager}" IsVisible="{Binding ShowHomeSaves}" />
      <ContentControl Content="{Binding Help}" IsVisible="{Binding IsHelpOpen}" />
      <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding ShowPage}" />
      <!-- Selecao multipla (Ctrl/Shift+clique): barra flutuante com o total e as acoes do grupo -->
      <Border Classes="selectionBar" IsVisible="{Binding HasDesktopMarks}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              ToolTip.Tip="Ctrl+clique marca ou desmarca · Shift+clique marca um intervalo · Ctrl+A marca a caixa toda · Esc desmarca">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="✓" Classes="markCheck" VerticalAlignment="Center" />
          <TextBlock Text="{Binding MarkedText}" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="Arraste um deles para mover o grupo (Ctrl copia)" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          <Button Classes="small danger" Content="🗑  Excluir" Command="{Binding DeleteMarkedCommand}" ToolTip.Tip="Apaga os marcados (Delete)" />
          <Button Classes="small" Content="✕  Limpar" Command="{Binding ClearMarksCommand}" ToolTip.Tip="Desmarca todos (Esc)" />
        </StackPanel>
      </Border>
      </Panel>
    </DockPanel>

    <!-- Editor -->
    <Border Grid.Column="2" Width="{Binding $parent[views:MainView].Bounds.Width, Converter={x:Static controls:WidthPickConverter.Instance}, ConverterParameter='1400,410,360'}" Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" IsVisible="{Binding ShowEditorPanel}">
      <Panel>
        <TextBlock Text="Selecione um slot" Classes="muted" IsVisible="{Binding !HasEditor}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding HasEditor}">
          <ContentControl Content="{Binding Editor}" Margin="16,20" />
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Barra de acoes + status -->
    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="actionBar">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button x:Name="BoxFolderButton" Classes="small" Content="⋯" IsVisible="{Binding ShowBoxFolderActions}" ToolTip.Tip="Caixas em pasta">
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="8" MaxWidth="320">
                  <TextBlock Text="Exportar caixas" Classes="section" />
                  <CheckBox Content="Todas as caixas (desmarque para só esta caixa)" IsChecked="{Binding ExportAllBoxes}" />
                  <CheckBox Content="Uma subpasta por caixa" IsChecked="{Binding BoxSubfolders}" />
                  <Button Content="Exportar caixas para pasta..." Click="OnExportBoxFolder" />
                  <StackPanel Spacing="8" IsVisible="{Binding !Hardcore}">
                  <TextBlock Text="Importar caixas" Classes="section" />
                  <CheckBox Content="Da primeira caixa (desmarque para esta caixa)" IsChecked="{Binding ImportFirstBox}" />
                  <CheckBox Content="Limpar as caixas antes" IsChecked="{Binding ClearImportBoxes}" />
                  <CheckBox Content="Sobrescrever slots ocupados" IsChecked="{Binding OverwriteImportSlots}" />
                  <Button Content="Importar pasta para as caixas..." Click="OnImportBoxFolder" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowSlotActions}">
          <Button Classes="small" Content="↶" FontSize="16" Padding="10,0" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" />
          <Button Classes="small" Content="↷" FontSize="16" Padding="10,0" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" />
          <Button Classes="small good" Content="✓  Verificar legalidade" Command="{Binding CheckLegalityCommand}"
                  ToolTip.Tip="Verifica todos os Pokémon do save (caixas e equipe) e mostra o resultado" />
          <Button Classes="small info" Content="+  Criar PKM" Command="{Binding CreateCommand}" IsVisible="{Binding !Hardcore}"
                  ToolTip.Tip="Novo Pokémon no primeiro slot vazio da caixa" />
          <Button Classes="small" Content="⭳  Importar" Click="OnImportEntity" IsVisible="{Binding !Hardcore}"
                  ToolTip.Tip="Importa um arquivo .pk* para o slot selecionado (ou o primeiro vazio)" />
          <Button Classes="small danger" Content="🗑  Excluir" Command="{Binding DeleteCommand}"
                  ToolTip.Tip="Apaga o Pokémon selecionado ou os marcados com Ctrl+clique (Delete). No save, dá para desfazer com Ctrl+Z" />
          <Button Classes="small" Content="⭱  Exportar PKM" Click="OnExportEntity" IsEnabled="{Binding CanExportEntity}"
                  ToolTip.Tip="Salva o Pokémon selecionado como arquivo .pk* (ou arraste o slot para fora da janela)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowGameHistoryActions}">
            <Button Classes="small" Content="↶" FontSize="16" Padding="10,0" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" />
            <Button Classes="small" Content="↷" FontSize="16" Padding="10,0" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" />
          </StackPanel>
          <Button Classes="small" Content="Adicionar ao save" IsVisible="{Binding ShowGiftActions}" IsEnabled="{Binding Game.HasCards}" Command="{Binding AddSelectedCardCommand}" ToolTip.Tip="Guarda o cartão selecionado para receber dentro do jogo" />
          <Button Classes="small" Content="‹  Voltar" IsVisible="{Binding IsHelpOpen}" Command="{Binding CloseHelpCommand}" ToolTip.Tip="Voltar à página anterior (Esc)" />
          <StackPanel Orientation="Horizontal" Spacing="1" IsVisible="{Binding ShowSaveActions}">
            <Button Classes="accent small primary splitLeft" Content="💾  Salvar" Click="OnQuickSave"
                    ToolTip.Tip="Grava por cima do arquivo do save, sem abrir janela (Ctrl+S). O arquivo anterior vai para os backups antes. Para escolher outro lugar, use a seta ao lado (Salvar como..., Ctrl+E)." />
            <Button Classes="accent small primary splitRight" Content="▾" ToolTip.Tip="Mais opções de salvar">
              <Button.Flyout>
                <MenuFlyout Placement="TopEdgeAlignedRight">
                  <MenuItem Header="Salvar como... (Ctrl+E)" Click="OnExport" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Atualizacao: Pokebolas ganhando cor e a equipe andando sobre a barra ("Continuar usando" esconde) -->
    <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Classes="dialogBackdrop" IsVisible="{Binding Help.ShowUpdateOverlay}">
      <Border Classes="card dialog" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Help.OverlayText}" Classes="title" TextWrapping="Wrap" />
          <controls:UpdateAnimation Progress="{Binding Help.AnimationProgress}" Margin="0,4" />
          <TextBlock Text="{Binding Help.OverlayHint}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Continuar usando" Command="{Binding Help.HideOverlayCommand}" />
            <Button Classes="accent" Content="{Binding Help.RestartText}" Command="{Binding Help.RestartCommand}"
                    IsVisible="{Binding Help.IsReadyToRestart}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Vitrine da equipe (MainViewModel.Showcase): cobre o app; Fechar ou Esc volta -->
    <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Classes="dialogBackdrop" IsVisible="{Binding HasShowcase}">
      <Border Classes="card dialog" Margin="24" MaxWidth="1340" HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:TeamShowcaseView x:Name="ShowcaseView" DataContext="{Binding Showcase}" />
      </Border>
    </Border>

    <!-- Pergunta dentro da janela (ConfirmAsync): cobre tudo e bloqueia cliques ate responder -->
    <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Classes="dialogBackdrop" IsVisible="{Binding HasQr}">
      <Border Classes="card dialog" DataContext="{Binding Qr}" x:DataType="vm:QrPreviewViewModel" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding Title}" Classes="title" />
          <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
          <Border Background="White" Padding="12" HorizontalAlignment="Center">
            <Image Source="{Binding Image}" Width="320" Height="320" Stretch="Uniform" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Fechar" Command="{Binding CloseCommand}" />
            <Button Content="Salvar imagem" Command="{Binding SaveCommand}" Classes="accent" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.ColumnSpan="3" Grid.RowSpan="2" Classes="dialogBackdrop" IsVisible="{Binding HasDialog}">
      <Border Classes="card dialog" DataContext="{Binding Dialog}" x:DataType="vm:ConfirmDialogViewModel"
              HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Icon}" FontSize="26" VerticalAlignment="Center" IsVisible="{Binding HasIcon}"
                       Classes.good="{Binding !IsDanger}" Classes.bad="{Binding IsDanger}" />
            <TextBlock Text="{Binding Title}" Classes="title" FontSize="18" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
          <TextBox x:Name="DialogInput" Text="{Binding Input}" IsVisible="{Binding HasInput}" />
          <Expander Header="Detalhes" IsExpanded="{Binding DetailsExpanded, Mode=OneWay}" IsVisible="{Binding HasDetails}" HorizontalAlignment="Stretch">
          <Border Classes="dialogDetails">
            <ScrollViewer MaxHeight="300">
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          </Expander>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" ToolTip.Tip="Esc" IsVisible="{Binding HasCancel}" />
            <Button Classes="accent" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" ToolTip.Tip="Enter" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
