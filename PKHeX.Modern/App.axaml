<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:PKHeX.Modern.Views"
             xmlns:vm="using:PKHeX.Modern.ViewModels"
             xmlns:v="using:PKHeX.Modern.Views"
             xmlns:c="using:PKHeX.Modern.Controls"
             xmlns:svc="using:PKHeX.Modern.Services"
             x:Class="PKHeX.Modern.App"
             RequestedThemeVariant="Dark">
  <!-- Cada pagina/ViewModel ganha sua View aqui (um DataTemplate por feature). -->
  <Application.DataTemplates>

  <DataTemplate DataType="vm:SaveManagerViewModel">
    <v:SaveManagerView />
  </DataTemplate>

  <!-- Cartao de encontro / Mystery Gift (bancos "Encontros" e "Eventos") -->
  <DataTemplate DataType="vm:EncounterCardViewModel">
    <Button Classes="encCardButton" Command="{Binding $parent[UserControl].((vm:EncounterListPageViewModel)DataContext).SelectCommand}"
            CommandParameter="{Binding}">
    <Border Classes="card encCard" Classes.selected="{Binding IsSelected}" Width="280">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,Auto" ColumnSpacing="12">
        <Border Classes="spriteWell" Width="68" Height="60" VerticalAlignment="Top">
          <Image Source="{Binding Sprite}" Stretch="Uniform" Margin="4" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Level}" FontSize="12" />
          <TextBlock Text="{Binding Location}" FontSize="12" IsVisible="{Binding HasLocation}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Game}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Border Classes="chip" Background="{DynamicResource CardBorder}" IsVisible="{Binding IsEgg}"><TextBlock Text="Ovo" /></Border>
            <Border Classes="chip" Background="#B8860B" IsVisible="{Binding IsShiny}"><TextBlock Text="★ Shiny" /></Border>
            <Border Classes="chip" Background="{DynamicResource CardBorder}" IsVisible="{Binding IsShinyLocked}" ToolTip.Tip="Nunca é shiny (shiny lock)"><TextBlock Text="🔒" /></Border>
            <Border Classes="chip" Background="#2F80ED" IsVisible="{Binding IsHomeGift}" ToolTip.Tip="Presente do Pokémon HOME"><TextBlock Text="HOME" /></Border>
          </StackPanel>
          <Button Grid.Column="1" Classes="small" Content="Usar"
                  Command="{Binding $parent[UserControl].((vm:EncounterListPageViewModel)DataContext).UseCommand}"
                  CommandParameter="{Binding}" ToolTip.Tip="Gera este Pokémon e abre no editor (grava só ao Aplicar)" />
        </Grid>
      </Grid>
    </Border>
    </Button>
  </DataTemplate>

  <!-- Painel de detalhes do encontro/evento selecionado (paginas Encontros e Eventos) -->
  <DataTemplate DataType="vm:EncounterDetailViewModel">
    <Border Classes="card" Width="340">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
          <Border Classes="spriteWell" Width="84" Height="76">
            <Image Source="{Binding Card.Sprite}" Stretch="Uniform" Margin="4" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Card.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Card.Kind}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Card.Game}" Classes="muted" FontSize="11" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost small" Content="✕" VerticalAlignment="Top" ToolTip.Tip="Fechar detalhes"
                  Command="{Binding $parent[UserControl].((vm:EncounterListPageViewModel)DataContext).CloseDetailCommand}" />
        </Grid>
        <Button DockPanel.Dock="Bottom" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,12,0,0"
                Content="Usar este encontro" Command="{Binding $parent[UserControl].((vm:EncounterListPageViewModel)DataContext).UseCommand}"
                CommandParameter="{Binding Card}" ToolTip.Tip="Gera este Pokémon e abre no editor (grava só ao Aplicar)" />
        <ScrollViewer>
          <StackPanel Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="ENCONTRO" Classes="section" Margin="0" />
              <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                <TextBlock Text="Local" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding Card.Location}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Nível" Classes="muted" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Card.Level}" />
                <TextBlock Grid.Row="2" Text="Tipo" Classes="muted" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Card.Category}" />
              </Grid>
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="O QUE ELE GARANTE" Classes="section" Margin="0" />
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EncounterFact">
                    <Grid ColumnDefinitions="96,*" Margin="0,2">
                      <TextBlock Text="{Binding Label}" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Image Source="{Binding BallIcon}" Width="24" Height="24" HorizontalAlignment="Left" Margin="96,2,0,0"
                     IsVisible="{Binding BallIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Text="GOLPES" Classes="section" Margin="0" />
              <TextBlock Text="{Binding MovesHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasMoves}" />
              <ItemsControl ItemsSource="{Binding Moves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EncounterMoveViewModel">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                      <Border Classes="chip" Background="{Binding TypeBrush}" MinWidth="64"><TextBlock Text="{Binding TypeName}" HorizontalAlignment="Center" /></Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Expander Header="Texto completo do PKHeX" HorizontalAlignment="Stretch">
              <SelectableTextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" />
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DataTemplate>

  <!-- Pagina Bank: duas telas lado a lado (bank local | save aberto). Arraste entre elas para guardar ou trazer Pokemon. -->
  <!-- Inicio: cartao do jogo, equipe no topo, atalhos grandes e saves recentes -->
  <DataTemplate DataType="vm:HomePageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="18" MaxWidth="1100">
        <Border Classes="card">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="18">
            <Border Classes="gameBadge" Width="72" Height="72" CornerRadius="{DynamicResource Radius16}" Background="{Binding Art.Background}">
              <Viewbox Margin="4">
                <Panel Width="100" Height="100">
                  <Image Source="{Binding Art.Sprite}" IsVisible="{Binding !Art.IsDual}" />
                  <Image Source="{Binding Art.Sprite}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Image Source="{Binding Art.Sprite2}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Panel>
              </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="{Binding GameName}" FontSize="24" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Trainer}" Classes="muted" FontSize="13" />
              <TextBlock Text="{Binding Facts}" Classes="muted" FontSize="13" />
            </StackPanel>
            <!-- Status do save: alteracoes, ultimo backup, vagas e arquivo (clicaveis quando tem acao) -->
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Status}" Margin="0,14,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HomeStatusViewModel">
                  <Panel>
                    <Button Classes="homeStatus" Classes.warning="{Binding IsWarning}" Command="{Binding Command}"
                            IsVisible="{Binding HasCommand}" ToolTip.Tip="{Binding Tip}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Button>
                    <Border Classes="homeStatus" Classes.warning="{Binding IsWarning}" IsVisible="{Binding !HasCommand}" ToolTip.Tip="{Binding Tip}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Value}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasParty}">
          <TextBlock Text="EQUIPE" Classes="section" Margin="0" />
          <ItemsControl ItemsSource="{Binding Party}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomePartyViewModel">
                <Button Classes="homeParty" Command="{Binding OpenCommand}" ToolTip.Tip="Abrir na página Equipe">
                  <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <Panel>
                      <Image Source="{Binding Sprite}" Width="72" Height="72" />
                      <TextBlock Text="★" Classes="shiny" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsShiny}" />
                    </Panel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Level}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Linha do tempo do save (Services/SaveTimeline.cs): o que mudou entre uma abertura e outra -->
        <StackPanel Spacing="8">
          <TextBlock Text="LINHA DO TEMPO" Classes="section" Margin="0" />
          <Border Classes="card" Padding="16,12">
            <Panel>
              <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasNoTimeline}"
                         Text="Nada mudou desde a última vez. A cada abertura, o Início compara com a anterior e mostra o que mudou: horas de jogo, Pokémon e espécies novas, shinies, insígnias e Pokédex." />
              <ItemsControl ItemsSource="{Binding TimelineEntries}" IsVisible="{Binding HasTimeline}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HomeTimelineViewModel">
                    <Grid ColumnDefinitions="118,22,*" Margin="0,0,0,2">
                      <StackPanel Spacing="3" Margin="0,2,0,12">
                        <TextBlock Text="{Binding When}" FontWeight="SemiBold" FontSize="13" />
                        <Border Classes="chip timelineSource" Classes.app="{Binding IsFromApp}" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding Source}" />
                        </Border>
                      </StackPanel>
                      <!-- Trilho: bolinha e linha vertical -->
                      <Panel Grid.Column="1">
                        <Border Width="2" Background="{DynamicResource CardBorder}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0" />
                      </Panel>
                      <StackPanel Grid.Column="2" Spacing="3" Margin="6,1,0,12">
                        <ItemsControl ItemsSource="{Binding Changes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                              <TextBlock Text="{Binding}" FontSize="13" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Shinies}" IsVisible="{Binding HasShinies}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="Bitmap">
                              <Image Source="{Binding}" Width="40" Height="36" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Text="ATALHOS" Classes="section" Margin="0" />
          <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeTileViewModel">
                <Button Classes="homeTile" Command="{Binding Command}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <c:LineIcon Kind="{Binding Icon}" Width="30" Height="30" Margin="3,0" StrokeWidth="1.7" VerticalAlignment="Center"
                                Foreground="{DynamicResource Accent}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="muted" FontSize="10" VerticalAlignment="Top" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasRecent}">
          <TextBlock Text="SAVES RECENTES" Classes="section" Margin="0" />
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HomeRecentViewModel">
                <Button Classes="homeRecent" Command="{Binding OpenCommand}" ToolTip.Tip="Abrir numa aba nova">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Classes="gameBadge" Width="40" Height="40" CornerRadius="{DynamicResource Radius8}" Background="{Binding Art.Background}">
                      <Viewbox Margin="2">
                        <Panel Width="100" Height="100">
                          <Image Source="{Binding Art.Sprite}" IsVisible="{Binding !Art.IsDual}" />
                          <Image Source="{Binding Art.Sprite}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Left" VerticalAlignment="Top" />
                          <Image Source="{Binding Art.Sprite2}" IsVisible="{Binding Art.IsDual}" Width="70" Height="70" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Panel>
                      </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Game}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate DataType="vm:BankPageViewModel">
    <UserControl>
    <Grid ColumnDefinitions="*,16,*">

      <!-- Esquerda: bank local, pasta externa ou um segundo save -->
      <Border Classes="card bankPane">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,10">
            <Button Classes="small" Classes.accent="{Binding ShowBank}" Content="🏦  Bank" Command="{Binding ShowBankCommand}"
                    ToolTip.Tip="Bancos do app e pastas de arquivos .pk*" />
            <Button Classes="small" Classes.accent="{Binding ShowOther}" Content="💾  Outro save" Command="{Binding ShowOtherCommand}"
                    ToolTip.Tip="Abre um segundo save aqui para mover Pokémon entre dois jogos (com conversão de geração)" />
          </StackPanel>
          <Panel>
          <DockPanel Classes="boxSwipe" IsVisible="{Binding ShowBank}">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding ShowSelectors}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="BANCO" Classes="section" Margin="0" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Banks}" SelectedItem="{Binding SelectedBank}"
                        ToolTip.Tip="Banco (cada banco tem as suas caixas)" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button Classes="small" Content="CSV" Command="{Binding ExportReportCommand}" ToolTip.Tip="Exportar relatório (CSV)" />
                <Button Classes="small" Content="+" Command="{Binding NewBankCommand}" ToolTip.Tip="Novo banco" />
                <Button Classes="small" Content="📁+" Command="{Binding AddFolderCommand}"
                        ToolTip.Tip="Usar uma pasta com arquivos .pk* como banco (ex.: a pasta de Pokémon do PKHeX). Os arquivos ficam onde estão." />
                <Button Classes="small" Content="✎" Command="{Binding RenameBankCommand}" IsVisible="{Binding IsLocal}" ToolTip.Tip="Renomear banco" />
                <Button Classes="small danger" Content="🗑" Command="{Binding DeleteBankCommand}" IsVisible="{Binding IsLocal}" ToolTip.Tip="Excluir banco (e todas as caixas dele)" />
                <Button Classes="small" Content="✕ Pasta" Command="{Binding RemoveFolderCommand}" IsVisible="{Binding IsExternal}"
                        ToolTip.Tip="Tira a pasta da lista de bancos (os arquivos não são apagados)" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
              <Button Classes="boxArrow" Content="‹" FontSize="16" Command="{Binding PreviousBoxCommand}"
                      ToolTip.Tip="Caixa anterior (arraste um Pokémon até aqui para trocar de caixa)" />
              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding BoxNames}" SelectedIndex="{Binding BoxIndex}" />
              <Button Grid.Column="2" Classes="boxArrow" Content="›" FontSize="16" Command="{Binding NextBoxCommand}"
                      ToolTip.Tip="Próxima caixa (arraste um Pokémon até aqui para trocar de caixa)" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsLocal}">
                <Button Classes="small" Content="+ Caixa" Command="{Binding NewBoxCommand}" ToolTip.Tip="Nova caixa neste banco" />
                <Button Classes="small" Content="✎" Command="{Binding RenameBoxCommand}" ToolTip.Tip="Renomear caixa" />
                <Button Classes="small danger" Content="🗑" Command="{Binding DeleteBoxCommand}" ToolTip.Tip="Excluir caixa" />
              </StackPanel>
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="4" IsVisible="{Binding IsLocal}">
              <ToggleSwitch IsChecked="{Binding AttachMode}" OnContent="🔗 Anexar ao trazer" OffContent="Anexar ao trazer" FontSize="12"
                            ToolTip.Tip="Ligado: levar um Pokémon do bank para um save copia em vez de mover. O original fica no bank, ligado ao save, e Atualizar anexados traz de volta a versão do jogo (nível, golpes, evolução)." />
              <Button Classes="small" Content="{Binding AttachedText}" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).SyncAttachedCommand}"
                      ToolTip.Tip="Procura cada Pokémon anexado no save ligado a ele e traz a versão do jogo para o bank (de outra geração, guarda como variante)" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
              <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost small" Content="⇅ Ordenar" IsVisible="{Binding IsLocal}" ToolTip.Tip="Ordena esta caixa do bank (grava na hora, sem desfazer)">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Ordenar esta caixa por" ItemsSource="{Binding SortOptions}">
                <MenuItem.Styles>
                  <Style Selector="MenuItem MenuItem" x:DataType="vm:SortOptionViewModel">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding SortCurrentCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="2" Classes="ghost small" Content="📁 Pasta" Command="{Binding OpenFolderCommand}"
                      ToolTip.Tip="Abre a pasta desta caixa no Explorer (os Pokémon são arquivos .pk*)" />
            </Grid>
          </StackPanel>
          <!-- Variantes do anexado selecionado (versao de cada jogo de outra geracao) -->
          <ContentControl DockPanel.Dock="Bottom" Content="{Binding Details}" IsVisible="{Binding HasDetails}" MaxHeight="{Binding DetailsMaxHeight}" Margin="0,8,0,0" />
          <Border DockPanel.Dock="Bottom" Classes="variantsPanel" IsVisible="{Binding HasVariants}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding VariantsTitle}" Classes="section" Margin="0" TextTrimming="CharacterEllipsis" />
              <ItemsControl ItemsSource="{Binding Variants}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BankVariantViewModel">
                    <Border Classes="variantRow">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Image Source="{Binding Sprite}" Width="36" Height="32" Stretch="Uniform" />
                        <Border Grid.Column="1" Classes="chip formatChip" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Format}" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                        </StackPanel>
                        <Button Grid.Column="3" Classes="small" Content="✎ Abrir no editor" Command="{Binding UseCommand}"
                                ToolTip.Tip="Leva esta versão para o save aberto (convertida, se precisar), no lugar da cópia anexada ou num slot vazio. Ao Aplicar, o anexado passa a apontar para este save." />
                        <Button Grid.Column="4" Classes="small danger" Content="🗑" Command="{Binding DeleteCommand}"
                                ToolTip.Tip="Apaga esta variante (o original do bank não muda)" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotViewModel">
                <Button Classes="slot compact" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                        Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
                        ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                  <c:TypeGlow />
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="✓" Classes="markCheck" FontSize="9" Padding="3,0" IsVisible="{Binding IsMarked}" />
                        <TextBlock Text="{Binding Position}" Classes="slotPos" FontSize="10" />
                        <TextBlock Text="🔗" FontSize="9" IsVisible="{Binding IsAttached}" ToolTip.Tip="{Binding AttachInfo}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="★" Classes="shiny" FontSize="11" IsVisible="{Binding IsShiny}" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="11" IsVisible="{Binding IsLegalBad}" />
                      </StackPanel>
                    </Grid>
                    <Panel Grid.Row="1">
                      <Image Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource CompactSpriteSize}" Margin="2" />
                      <Image Source="{Binding BallSprite}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Panel>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" IsVisible="{Binding !IsEmpty}">
                      <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          </DockPanel>

          <!-- Outro save -->
          <DockPanel Classes="boxSwipe" IsVisible="{Binding $parent[UserControl].((vm:BankPageViewModel)DataContext).ShowOther}" DataContext="{Binding Other}" x:DataType="vm:OtherSaveViewModel">
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                          PlaceholderText="Escolha um save da pasta do Save Manager" />
                <Button Grid.Column="1" Classes="small" Content="📂  Abrir arquivo..." Command="{Binding BrowseCommand}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasSave}">
                <Button Classes="boxArrow" Content="‹" FontSize="16" Command="{Binding PreviousBoxCommand}"
                        ToolTip.Tip="Caixa anterior (arraste um Pokémon até aqui para trocar de caixa)" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding BoxName}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding BoxLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Classes="boxArrow" Content="›" FontSize="16" Command="{Binding NextBoxCommand}"
                        ToolTip.Tip="Próxima caixa (arraste um Pokémon até aqui para trocar de caixa)" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasSave}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="● Alterações não salvas" Classes="unsaved" FontSize="11" IsVisible="{Binding IsDirty}" />
                </StackPanel>
                <Button Grid.Column="1" Classes="small" Content="↶" Command="{Binding UndoCommand}" ToolTip.Tip="{Binding UndoTip}" ToolTip.ShowOnDisabled="True" />
                <Button Grid.Column="2" Classes="small" Content="↷" Command="{Binding RedoCommand}" ToolTip.Tip="{Binding RedoTip}" ToolTip.ShowOnDisabled="True" />
                <Button Grid.Column="3" Classes="small accent" Content="💾  Salvar este save" Command="{Binding SaveCommand}"
                        ToolTip.Tip="Grava as mudanças no arquivo deste save (o arquivo anterior vai para os backups)" />
                <Button Grid.Column="4" Classes="small" Content="✕" Command="{Binding CloseCommand}" ToolTip.Tip="Fechar este save" />
              </Grid>
            </StackPanel>
            <Panel>
              <c:EmptyState IsVisible="{Binding HasNoSave}" Art="transfer" ArtSize="96" Margin="20" Title="Nenhum outro save aberto"
                            Hint="Escolha outro save para mover Pokémon entre ele e o save aberto à direita. Cada Pokémon é convertido para a geração do jogo de destino; depois salve os dois saves." />
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasSave}">
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotViewModel">
                <Button Classes="slot compact" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                        Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
                        ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                  <c:TypeGlow />
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="✓" Classes="markCheck" FontSize="9" Padding="3,0" IsVisible="{Binding IsMarked}" />
                        <TextBlock Text="{Binding Position}" Classes="slotPos" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="★" Classes="shiny" FontSize="11" IsVisible="{Binding IsShiny}" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="11" IsVisible="{Binding IsLegalBad}" />
                      </StackPanel>
                    </Grid>
                    <Panel Grid.Row="1">
                      <Image Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource CompactSpriteSize}" Margin="2" />
                      <Image Source="{Binding BallSprite}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Panel>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" IsVisible="{Binding !IsEmpty}">
                      <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  </Panel>
                </Button>
              </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Panel>
          </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Direita: save aberto (mesma caixa da pagina Caixas) -->
      <Border Grid.Column="2" Classes="card bankPane boxSwipe" DataContext="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext)}" x:DataType="vm:MainViewModel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="💾 SAVE" Classes="section" Margin="0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding GameName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" DataContext="{Binding Boxes}" x:DataType="vm:BoxesPageViewModel">
              <Button Classes="boxArrow" Content="‹" FontSize="16" Command="{Binding PreviousBoxCommand}"
                      ToolTip.Tip="Caixa anterior (arraste um Pokémon até aqui para trocar de caixa)" />
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding BoxName}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding BoxLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="2" Classes="boxArrow" Content="›" FontSize="16" Command="{Binding NextBoxCommand}"
                      ToolTip.Tip="Próxima caixa (arraste um Pokémon até aqui para trocar de caixa)" />
            </Grid>
            <StackPanel Spacing="4" IsVisible="{Binding Boxes.ShowParty}">
              <TextBlock Text="EQUIPE" Classes="section" Margin="0" FontSize="10" />
              <ItemsControl DataContext="{Binding Party}" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="6" Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotViewModel">
                <Button Classes="slot compact" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                        Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
                        ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                  <c:TypeGlow />
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="✓" Classes="markCheck" FontSize="9" Padding="3,0" IsVisible="{Binding IsMarked}" />
                        <TextBlock Text="{Binding Position}" Classes="slotPos" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="★" Classes="shiny" FontSize="11" IsVisible="{Binding IsShiny}" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="11" IsVisible="{Binding IsLegalBad}" />
                      </StackPanel>
                    </Grid>
                    <Panel Grid.Row="1">
                      <Image Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource CompactSpriteSize}" Margin="2" />
                      <Image Source="{Binding BallSprite}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Panel>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" IsVisible="{Binding !IsEmpty}">
                      <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
            </StackPanel>
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl DataContext="{Binding Boxes}" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotViewModel">
                <Button Classes="slot compact" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                        Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
                        ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                  <c:TypeGlow />
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="✓" Classes="markCheck" FontSize="9" Padding="3,0" IsVisible="{Binding IsMarked}" />
                        <TextBlock Text="{Binding Position}" Classes="slotPos" FontSize="10" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="★" Classes="shiny" FontSize="11" IsVisible="{Binding IsShiny}" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="11" IsVisible="{Binding IsLegalBad}" />
                      </StackPanel>
                    </Grid>
                    <Panel Grid.Row="1">
                      <Image Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource CompactSpriteSize}" Margin="2" />
                      <Image Source="{Binding BallSprite}" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    </Panel>
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" IsVisible="{Binding !IsEmpty}">
                      <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    </UserControl>
  </DataTemplate>

  <DataTemplate DataType="vm:BankDetailsViewModel">
    <Border Classes="card" Padding="10">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Text="Consulta do Bank · somente leitura" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="✕" Classes="ghost small" Command="{Binding CloseCommand}" />
        </Grid>
        <WrapPanel DockPanel.Dock="Top" ItemSpacing="4" LineSpacing="4" Margin="0,0,0,6">
          <Button Content="Abrir no editor" Classes="small" Command="{Binding OpenCommand}" IsEnabled="{Binding CanOpen}" />
          <Button Content="Exportar .pk*" Classes="small" Command="{Binding ExportCommand}" />
          <Button Content="Ver variantes" Classes="small" Command="{Binding VariantsCommand}" IsVisible="{Binding HasVariants}" />
          <Button Content="Copiar Showdown" Classes="small" Command="{Binding CopyCommand}" />
        </WrapPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
              <Image Source="{Binding Sprite}" Height="64" Stretch="Uniform" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                <TextBlock><Run Text="{Binding Nickname}" /></TextBlock>
                <TextBlock Text="{Binding Location}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding LegalityText}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:BankDetailField">
                <Grid ColumnDefinitions="140,*" ColumnSpacing="6"><TextBlock Text="{Binding Label}" Classes="muted" /><TextBlock Grid.Column="1" TextWrapping="Wrap"><Run Text="{Binding Value}" /></TextBlock></Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Golpes" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Moves}" />
            <TextBlock Text="IVs (HP / Atk / Def / SpA / SpD / Spe)" />
            <TextBlock Text="{Binding IVs}" />
            <c:StatRadar Height="140" Values="{Binding RadarValues}" Labels="{Binding StatLabels}" Fill="{DynamicResource Accent}" GridBrush="{DynamicResource CardBorder}" LabelBrush="{DynamicResource TextMuted}" />
            <TextBlock Text="EVs (HP / Atk / Def / SpA / SpD / Spe)" />
            <TextBlock Text="{Binding EVs}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"><Run Text="{Binding Folder}" /></TextBlock>
            <TextBlock Text="{Binding LegalityReport}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DataTemplate>

  <!-- Pokedex centralizada: todos os saves da pasta + save aberto + bank -->
  <DataTemplate DataType="vm:LivingDexViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock Text="Living Dex" Classes="title" />
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
          <TextBlock Text="Plano de caixas em ordem nacional, com o número de slots por caixa do jogo alvo. Use a prévia para organizar as caixas do save aberto." Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
 <Button Content="Gerar plano" Command="{Binding GenerateCommand}" />
 <Button Content="Cancelar leitura" Command="{Binding CancelReadCommand}" IsVisible="{Binding IsBusy}" />
</StackPanel>
      </Grid>
      <WrapPanel Grid.Row="1" ItemSpacing="12" LineSpacing="8" IsEnabled="{Binding !IsBusy}">
        <StackPanel Spacing="4"><TextBlock Text="Jogo alvo" /><ComboBox ItemsSource="{Binding TargetOptions}" SelectedIndex="{Binding TargetIndex}" MinWidth="180" /></StackPanel>
        <CheckBox Content="Incluir formas" IsChecked="{Binding IncludeForms}" />
        <CheckBox Content="Só shiny" IsChecked="{Binding ShinyOnly}" />
        <CheckBox Content="Saves abertos" IsChecked="{Binding IncludeOpen}" />
        <CheckBox Content="Pasta de saves" IsChecked="{Binding IncludeFolder}" />
        <CheckBox Content="Bank" IsChecked="{Binding IncludeBank}" />
      </WrapPanel>
      <StackPanel Grid.Row="2" Spacing="5">
 <WrapPanel ItemSpacing="8" LineSpacing="4">
  <TextBlock Text="Primeira caixa" VerticalAlignment="Center" />
  <NumericUpDown Value="{Binding FirstBox}" Minimum="1" Maximum="100" Width="100" FormatString="0" />
  <CheckBox Content="Reservar o lugar dos faltantes" IsChecked="{Binding ReserveMissing}" />
  <Button Content="Prévia da aplicação" Command="{Binding PreviewApplicationCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Conferir movimentos, cópias e realocações no save aberto, sem gravar." />
  <Button Content="Aplicar plano" Command="{Binding ApplyPlanCommand}" IsEnabled="{Binding CanApplyPlan}" ToolTip.Tip="Aplicar exatamente a prévia em memória. Desfazer reverte o lote inteiro." />
 </WrapPanel>
 <Expander Header="Conferir posições da prévia">
  <ScrollViewer MaxHeight="220"><ItemsControl ItemsSource="{Binding ApplicationDetails}">
   <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></ScrollViewer>
 </Expander>
        <TextBlock Text="{Binding Progress}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="5" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding Search}" Watermark="Buscar por nome ou número" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" MinWidth="170" />
        </Grid>
      </StackPanel>
      <Grid Grid.Row="3" ColumnDefinitions="*,12,280">
        <ListBox Classes="plainRows" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LivingDexRowViewModel">
              <Border Classes="card" Margin="0,0,0,6" Padding="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Location}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding AuditLabel}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding BoxPlan}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="2" Classes="card" IsVisible="{Binding HasSelection}">
          <ScrollViewer>
            <StackPanel DataContext="{Binding Selected}" x:DataType="vm:LivingDexRowViewModel" Spacing="10">
              <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding BoxPlan}" />
              <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Status}" />
              <Button Content="Abrir candidato" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" />
              <Button Content="Onde obter (Encontros)" Command="{Binding FindCommand}" IsVisible="{Binding Missing}" />
              <TextBlock Text="{Binding OthersSummary}" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding OtherLocations}" IsVisible="{Binding HasOthers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,3" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DataTemplate>
  <!-- Cacada shiny: alvo e metodo | contador e chances; abaixo, onde encontrar (locais, shiny lock, golpes perigosos) -->
  <DataTemplate DataType="vm:ShinyHuntPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" MaxWidth="1200" HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="Caçada shiny" Classes="title" />
            <TextBlock Text="Conte os encontros, veja as chances reais do jogo e onde o alvo aparece. Só lê o save." Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="small" Content="Exportar CSV" Command="{Binding ExportCsvCommand}" VerticalAlignment="Top"
                  ToolTip.Tip="Salva os troféus, a caçada atual e as fases numa planilha (CSV)" />
        </Grid>
        <TextBlock Text="Este jogo não tem chance de shiny que o app saiba calcular (a Gen 1 não tem shiny)." TextWrapping="Wrap" IsVisible="{Binding NoMethods}" />
        <Border Classes="legalBlock" IsVisible="{Binding IsOtherGame}">
          <TextBlock Text="{Binding OtherGameText}" TextWrapping="Wrap" FontSize="12" />
        </Border>
        <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding HasMethods}">
          <StackPanel Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="ALVO" Classes="section" Margin="0" FontSize="10" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <Border Classes="spriteWell" Width="72" Height="72">
                    <Image Source="{Binding TargetSprite}" Stretch="Uniform" Margin="6" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <c:FullListAutoComplete Text="{Binding TargetName}" ItemsSource="{Binding SpeciesNames}" MaxDropDownHeight="320"
                                            Watermark="Toque ou digite" />
                    <Button Classes="small" Content="Nova caçada" Command="{Binding NewHuntCommand}" HorizontalAlignment="Left"
                            ToolTip.Tip="Apaga a caçada atual (contador e tempo) para escolher outro alvo" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Escolha a espécie para começar. Os shiny dela que já estão no save não contam para o “Achei!”." Classes="muted" FontSize="12"
                           TextWrapping="Wrap" IsVisible="{Binding HasNoHunt}" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="MÉTODO" Classes="section" Margin="0" FontSize="10" />
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:ShinyMethod">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding MethodNote}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasParam1}">
                  <TextBlock Text="{Binding Param1Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <NumericUpDown Grid.Column="1" Value="{Binding Param1}" Minimum="0" Maximum="{Binding Param1Max}" Increment="1" FormatString="0" MinWidth="130" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasParam2}">
                  <TextBlock Text="{Binding Param2Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <NumericUpDown Grid.Column="1" Value="{Binding Param2}" Minimum="0" Maximum="{Binding Param2Max}" Increment="1" FormatString="0" MinWidth="130" />
                </Grid>
                <CheckBox Content="Shiny Charm" IsChecked="{Binding Charm}" IsVisible="{Binding CanUseCharm}" />
                <TextBlock Text="{Binding CharmNote}" Classes="muted" FontSize="11" IsVisible="{Binding CanUseCharm}" />
                <TextBlock Text="⚠ Valor a conferir: as fontes não concordam totalmente." FontSize="12" TextWrapping="Wrap" Classes="unsaved" IsVisible="{Binding MethodUnverified}" />
                <TextBlock Text="{Binding MethodSource}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MissingNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasMissingNote}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="12">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding CountText}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="encontros nesta caçada" Classes="muted" HorizontalAlignment="Center" FontSize="12" />
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                  <Button Classes="accent" Content="+1" FontSize="22" Height="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Command="{Binding AddOneCommand}" ToolTip.Tip="Conta um encontro (Espaço ou +)" />
                  <Button Grid.Column="1" Content="↶" FontSize="20" Height="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Command="{Binding UndoCommand}" ToolTip.Tip="Desfaz a última contagem (−)" />
                  <Button Grid.Column="2" Classes="danger" Content="Zerar" Height="56" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" Command="{Binding ResetCommand}" ToolTip.Tip="Volta o contador a zero (dá para desfazer)" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <NumericUpDown Value="{Binding Step}" Minimum="1" Maximum="999" Increment="1" FormatString="0" MinWidth="110" />
                  <Button Grid.Column="1" Content="Somar" Command="{Binding AddStepCommand}" HorizontalAlignment="Left"
                          ToolTip.Tip="Soma vários encontros de uma vez (ex.: uma horda de 5)" />
                </Grid>
                <TextBlock Text="Espaço ou + conta um encontro; − desfaz." Classes="muted" FontSize="11" HorizontalAlignment="Center" />
                <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0" IsVisible="{Binding !IsFinished}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Saiu um shiny que não era o alvo?" FontSize="12" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <c:FullListAutoComplete Text="{Binding PhaseSpeciesName}" ItemsSource="{Binding SpeciesNames}" MaxDropDownHeight="320"
                                              Watermark="Espécie (opcional)" />
                      <Button Grid.Column="1" Content="✨ Registrar fase" Command="{Binding LogPhaseCommand}"
                              ToolTip.Tip="Guarda o shiny como fase no encontro atual, sem zerar a caçada" />
                    </Grid>
                    <TextBlock Text="{Binding PhaseText}" Classes="muted" FontSize="12" IsVisible="{Binding HasPhases}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="card dexStats" IsVisible="{Binding IsFinished}">
              <TextBlock Text="{Binding FoundText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="CHANCES" Classes="section" Margin="0" FontSize="10" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding OddsText}" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom" />
                  <TextBlock Text="por encontro" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding ChanceText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding OverOddsText}" Classes="muted" FontSize="12" />
                <TextBlock Text="{Binding NextMilestoneText}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MilestonesText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                <c:OddsCurve Height="120" Probability="{Binding Probability}" Encounters="{Binding Count}" Stroke="{DynamicResource Accent}" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="{Binding TimeText}" Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding PaceText}" Classes="muted" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        <Border Classes="card" IsVisible="{Binding HasHunt}">
          <StackPanel Spacing="8">
            <TextBlock Text="ONDE ENCONTRAR" Classes="section" Margin="0" FontSize="10" />
            <TextBlock Text="Procurando os encontros deste jogo..." Classes="muted" IsVisible="{Binding IsLoadingLocations}" />
            <TextBlock Text="Nenhum encontro selvagem desta espécie neste jogo (pode vir de evento, troca ou evolução)." Classes="muted" TextWrapping="Wrap"
                       IsVisible="{Binding NoLocations}" />
            <Border Classes="legalBlock" IsVisible="{Binding AnyShinyLock}">
              <TextBlock Text="🔒 Todos os encontros desta espécie neste jogo têm shiny lock: ela nunca aparece shiny aqui." TextWrapping="Wrap" FontSize="12" />
            </Border>
            <ItemsControl ItemsSource="{Binding Locations}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HuntLocationViewModel">
                  <Border Classes="nuzRow" Background="{DynamicResource SlotBackground}" CornerRadius="{DynamicResource Radius8}" Padding="12,8">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding Location}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="11" />
                            <TextBlock Text="{Binding Levels}" Classes="muted" FontSize="11" />
                          </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="chip" Background="{DynamicResource Bad}" IsVisible="{Binding ShinyLocked}" VerticalAlignment="Top"
                                ToolTip.Tip="Este encontro nunca é shiny">
                          <TextBlock Text="🔒 Shiny lock" />
                        </Border>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Risks}" IsVisible="{Binding HasRisks}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="svc:RiskMove">
                            <TextBlock FontSize="12" TextWrapping="Wrap" Classes="unsaved">
                              <Run Text="⚠ " /><Run Text="{Binding Move}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Danger}" /><Run Text=" — " /><Run Text="{Binding Counter}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasPhases}">
          <StackPanel Spacing="8">
            <TextBlock Text="FASES" Classes="section" Margin="0" FontSize="10" />
            <ItemsControl ItemsSource="{Binding Phases}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HuntPhaseViewModel">
                  <Border Background="{DynamicResource SlotBackground}" CornerRadius="{DynamicResource Radius8}" Padding="12,8">
                    <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="10">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding When}" Classes="muted" FontSize="11" />
                          <TextBlock Text="{Binding Where}" Classes="muted" FontSize="11" IsVisible="{Binding HasWhere}" />
                        </StackPanel>
                      </StackPanel>
                      <c:FullListAutoComplete Grid.Column="1" Text="{Binding SpeciesName}" ItemsSource="{Binding SpeciesNames}" MaxDropDownHeight="320"
                                              Watermark="Qual shiny?" VerticalAlignment="Center" />
                      <Button Grid.Column="2" Classes="small" Content="✕" Command="{Binding RemoveCommand}" VerticalAlignment="Center"
                              ToolTip.Tip="Remove esta fase" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasTrophies}">
          <StackPanel Spacing="8">
            <TextBlock Text="TROFÉUS" Classes="section" Margin="0" FontSize="10" />
            <ItemsControl ItemsSource="{Binding Trophies}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HuntTrophyViewModel">
                  <Border Background="{DynamicResource SlotBackground}" CornerRadius="{DynamicResource Radius10}" Padding="12" Width="270">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <Image Source="{Binding Sprite}" Width="64" Height="64" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Game}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" FontSize="12" />
                        <TextBlock Text="{Binding Date}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding Where}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                          <Button Classes="small" Content="Ir" Command="{Binding GoCommand}" ToolTip.Tip="Abre este Pokémon no save (o save do jogo da caçada precisa estar aberto)" />
                          <Button Classes="small" Content="Remover" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove o troféu (o Pokémon continua no save)" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DataTemplate>
  <!-- Relatorio de Nuzlocke (aba da Pokedex): uma linha por rota com o primeiro encontro -->
  <DataTemplate DataType="vm:NuzlockeViewModel">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="Nuzlocke" Classes="title" />
          <TextBlock Text="O primeiro Pokémon capturado em cada rota, pelo local que o jogo guarda. Só lê o save." Classes="muted" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Caixa do cemitério" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding GraveyardOptions}" SelectedIndex="{Binding GraveyardIndex}" MinWidth="180"
                      ToolTip.Tip="Os Pokémon desta caixa contam como mortos. Uma caixa com “Cemitério”, “Grave” ou “Dead” no nome já vem escolhida." />
          </StackPanel>
          <Button Classes="small" Content="⟳ Atualizar" Command="{Binding RefreshCommand}" />
          <Button Classes="small" Content="📋 Copiar relatório" Command="{Binding CopyCommand}" IsEnabled="{Binding HasRoutes}"
                  ToolTip.Tip="Copia o relatório em texto, uma linha por rota, para colar num fórum ou rede social" />
        </WrapPanel>
        <Border Classes="card dexStats" IsVisible="{Binding HasRoutes}">
          <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="{Binding Note}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
      <Panel>
        <TextBlock Text="{Binding Unsupported}" TextWrapping="Wrap" IsVisible="{Binding IsUnsupported}" />
        <TextBlock Text="Nenhum Pokémon capturado neste jogo pelo treinador do save." Classes="muted" IsVisible="{Binding IsEmpty}" />
        <ScrollViewer IsVisible="{Binding HasRoutes}" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Routes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NuzlockeRouteViewModel">
                <Border Classes="card nuzRow" Classes.dead="{Binding IsDead}" Padding="12,8">
                  <Grid ColumnDefinitions="2*,Auto,3*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Route}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Date}" Classes="muted" FontSize="11" IsVisible="{Binding HasDate}" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="{Binding Sprite}" Width="44" Height="44" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Level}" Classes="muted" FontSize="11" />
                        <TextBlock Text="{Binding Where}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="3" VerticalAlignment="Center" ItemSpacing="6" LineSpacing="4" MaxWidth="260" HorizontalAlignment="Right">
                      <Border Classes="chip nuzStatus" Classes.dead="{Binding IsDead}" Classes.party="{Binding IsParty}">
                        <TextBlock Text="{Binding StatusText}" />
                      </Border>
                      <Border Classes="chip" Background="{DynamicResource CardBorder}" IsVisible="{Binding IsDupe}"
                              ToolTip.Tip="A família deste Pokémon já tinha sido capturada numa rota anterior (regra dos repetidos)">
                        <TextBlock Text="{Binding DupeText}" />
                      </Border>
                      <Border Classes="chip" Background="{DynamicResource CardBorder}" IsVisible="{Binding HasExtras}" ToolTip.Tip="{Binding ExtrasTip}">
                        <TextBlock Text="{Binding ExtrasText}" />
                      </Border>
                    </WrapPanel>
                    <Button Grid.Column="4" Classes="small" Content="Ir" Command="{Binding GoCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Abre este Pokémon no save" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </DataTemplate>
  <DataTemplate DataType="vm:PokedexPageViewModel">
    <Grid RowDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
        <Button Content="Coleção" Command="{Binding ShowCollectionCommand}" Classes.accent="{Binding ShowCollection}" />
        <Button Content="Living Dex" Command="{Binding ShowLivingDexCommand}" Classes.accent="{Binding ShowLivingDex}" />
        <Button Content="Nuzlocke" Command="{Binding ShowNuzlockeCommand}" Classes.accent="{Binding ShowNuzlocke}"
                ToolTip.Tip="Relatório de Nuzlocke do save aberto: o primeiro encontro de cada rota, repetidos, vivos e mortos" />
      </StackPanel>
      <ContentControl Grid.Row="1" Content="{Binding LivingDex}" IsVisible="{Binding ShowLivingDex}" />
      <ContentControl Grid.Row="1" Content="{Binding Nuzlocke}" IsVisible="{Binding ShowNuzlocke}" />
    <Grid Grid.Row="1" ColumnDefinitions="*,16,Auto" IsVisible="{Binding ShowCollection}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          <StackPanel Spacing="2">
            <TextBlock Text="Pokédex" Classes="title" />
            <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
          </StackPanel>
          <WrapPanel ItemSpacing="6" LineSpacing="6">
            <ToggleButton Content="◉  Só o save aberto" IsChecked="{Binding OnlyOpenSave}" IsEnabled="{Binding HasOpenSave}" Padding="10,4" FontSize="12"
                          ToolTip.Tip="Mostra só a Pokédex do save aberto: o que ele viu, capturou e tem guardado, sem misturar com os outros saves nem com o bank" />
            <Button Classes="small info" Content="⇄  Sincronizar com o save aberto" Command="{Binding SyncCommand}"
                    ToolTip.Tip="Marca na Pokédex do save aberto o que foi capturado/visto nos outros saves e o que você tem guardado (caixas e bank)" />
            <Button Classes="small" Content="⇄  Sincronizar todos os saves" Command="{Binding SyncAllCommand}"
                    ToolTip.Tip="Registra em cada save da pasta (e no aberto) o que foi capturado ou visto nos outros e o que está guardado nas caixas/bank. Os saves fechados são gravados na hora, com backup." />
            <Button Classes="small" Content="⟳  Atualizar" Command="{Binding RefreshCommand}"
                    ToolTip.Tip="Relê os saves da pasta, o save aberto e o bank" />
            <Button Classes="small accent" Content="✔  Completar Pokédex do save ▾" IsVisible="{Binding CanEditDex}"
                    ToolTip.Tip="Completar ou limpar a Pokédex do save aberto (vistas, capturadas, formas, gêneros e idiomas). Ctrl+Z desfaz.">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                  <StackPanel Spacing="6" MinWidth="280">
                    <TextBlock Text="{Binding DexCounts}" Classes="muted" FontSize="12" />
                    <Button Classes="small accent" HorizontalAlignment="Stretch" Content="✔  Completar (vistas e capturadas)" Command="{Binding DexActionCommand}" CommandParameter="Complete" />
                    <Button Classes="small" HorizontalAlignment="Stretch" Content="👁  Marcar todas como vistas" Command="{Binding DexActionCommand}" CommandParameter="SeenAll" />
                    <CheckBox Content="Incluir shiny (vistas)" IsChecked="{Binding IncludeShiny}" IsVisible="{Binding HasShinyOption}"
                              ToolTip.Tip="Marca também as formas shiny como vistas (Gen 5 em diante)" />
                    <Separator />
                    <Button Classes="small" HorizontalAlignment="Stretch" Content="Tirar as capturadas" Command="{Binding DexActionCommand}" CommandParameter="CaughtNone" />
                    <Button Classes="small danger" HorizontalAlignment="Stretch" Content="Limpar a Pokédex" Command="{Binding DexActionCommand}" CommandParameter="Clear" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
          </WrapPanel>
        </StackPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="3*,2*,1.4*,2*" ColumnSpacing="8" Margin="0,0,0,8">
          <TextBox Text="{Binding Search}" Watermark="Buscar por nome ou número (ex.: pika, 25)" MinWidth="0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusIndex}" HorizontalAlignment="Stretch" MinWidth="0"
                    ToolTip.Tip="Situação: possuída (está numa caixa, equipe ou no bank), capturada/vista (pela Pokédex dos saves)" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding TypeOptions}" SelectedIndex="{Binding TypeIndex}" HorizontalAlignment="Stretch" MinWidth="0" />
          <ComboBox Grid.Column="3" ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" HorizontalAlignment="Stretch" MinWidth="0"
                    ToolTip.Tip="Contar tudo junto ou só um save (ou só o bank)" />
        </Grid>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding Generations}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GenerationFilterViewModel">
                <Button Classes="small" Classes.accent="{Binding IsActive}" Content="{Binding Label}"
                        ToolTip.Tip="Só esta geração (clique de novo para mostrar todas)"
                        Command="{Binding $parent[ItemsControl].((vm:PokedexPageViewModel)DataContext).SetGenerationCommand}"
                        CommandParameter="{Binding Generation}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
            <CheckBox Content="Formas e gêneros" IsChecked="{Binding ShowForms}"
                      ToolTip.Tip="Cada forma (Alola, Galar, Unown A–?...) e cada gênero com sprite próprio vira uma entrada; formas só de batalha (Mega, Gigantamax) ficam de fora" />
            <TextBlock Text="{Binding VisibleCount}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Classes="card dexStats" Margin="0,0,0,10">
          <TextBlock Text="{Binding Stats}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
        </Border>
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <!-- Grade virtualizada: so os cartoes visiveis na tela sao criados (sao 1025 especies) -->
            <ItemsRepeater ItemsSource="{Binding VisibleCards}">
              <ItemsRepeater.Layout>
                <c:DexGridLayout />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:DexCardViewModel">
                  <Button Classes="dexCard" Classes.owned="{Binding IsOwned}" Classes.missing="{Binding !IsSeen}"
                          Classes.selected="{Binding IsSelected}" ToolTip.Tip="{Binding Tooltip}"
                          Command="{Binding $parent[ItemsRepeater].((vm:PokedexPageViewModel)DataContext).SelectCommand}"
                          CommandParameter="{Binding}">
                    <Grid RowDefinitions="Auto,*,Auto">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Number}" Classes="slotPos" FontSize="10" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                          <TextBlock Text="★" Classes="shiny" FontSize="11" IsVisible="{Binding IsShinyOwned}" />
                          <TextBlock Text="α" Classes="alpha" FontSize="11" FontWeight="Bold" IsVisible="{Binding IsAlphaOwned}" ToolTip.Tip="Alpha" />
                          <TextBlock Text="{Binding OwnedText}" Classes="muted" FontSize="10" />
                          <TextBlock Text="●" Classes="dexOwned" FontSize="10" IsVisible="{Binding IsOwned}" />
                        </StackPanel>
                      </Grid>
                      <Image Grid.Row="1" Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource DexSpriteSize}" Margin="2" />
                      <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FormName}" Classes="muted" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasFormName}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>
          <TextBlock Text="Lendo saves e bank..." Classes="muted" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </DockPanel>

      <!-- Detalhes da especie selecionada -->
      <Border Grid.Column="2" Classes="card" Width="{Binding $parent[UserControl].Bounds.Width, Converter={x:Static c:WidthPickConverter.Instance}, ConverterParameter='1400,320,250'}">
        <Panel>
          <!-- Sem especie escolhida: resumo da colecao, o que falta por geracao e "proxima que falta" -->
          <ScrollViewer IsVisible="{Binding !HasSelection}">
            <StackPanel Spacing="14">
              <TextBlock Text="RESUMO" Classes="section" Margin="0" FontSize="10" />
              <ItemsControl ItemsSource="{Binding Progress}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DexProgressViewModel">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="muted" FontSize="12" />
                      </Grid>
                      <ProgressBar Classes="dexProgress" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="FALTAM POR GERAÇÃO" Classes="section" Margin="0,4,0,0" FontSize="10" IsVisible="{Binding !IsComplete}" />
              <TextBlock Text="✔ Living dex completa neste filtro." FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsComplete}" />
              <ItemsControl ItemsSource="{Binding MissingByGeneration}" IsVisible="{Binding !IsComplete}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DexMissingGenViewModel">
                    <Button Classes="ghost small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding Command}" CommandParameter="{Binding Generation}" ToolTip.Tip="Mostra só as que faltam desta geração">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="muted" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Próxima que falta ›"
                      Command="{Binding NextMissingCommand}" IsVisible="{Binding !IsComplete}"
                      ToolTip.Tip="Escolhe a primeira espécie da lista que você ainda não tem" />
              <!-- Fabrica de ovos: gera ovos legais no save aberto, nas vagas livres das caixas -->
              <StackPanel Spacing="6" IsVisible="{Binding CanMakeEggs}">
                <TextBlock Text="FÁBRICA DE OVOS" Classes="section" Margin="0,4,0,0" FontSize="10" />
                <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="🥚 Ovos das que faltam"
                        Command="{Binding MissingEggsCommand}"
                        ToolTip.Tip="Um ovo legal para cada espécie que falta no save aberto (da forma básica: um ovo de Charmander para o Charizard que falta), nas vagas livres das caixas. Mostra a lista antes de gravar e tem Ctrl+Z." />
                <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="🥚 Um ovo de cada família"
                        Command="{Binding FamilyEggsCommand}"
                        ToolTip.Tip="Um ovo legal de cada família que nasce de ovo neste jogo, nas vagas livres das caixas. Mostra a lista antes de gravar e tem Ctrl+Z." />
                <TextBlock Text="Só no save aberto, nas vagas livres das caixas." Classes="muted" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Text="Clique numa espécie para ver onde estão os seus Pokémon e em quais Pokédex ela foi registrada."
                         Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer IsVisible="{Binding HasSelection}">
            <StackPanel Spacing="10" DataContext="{Binding Selected}" x:DataType="vm:DexCardViewModel">
              <Button Classes="ghost small" Content="‹ Resumo" HorizontalAlignment="Left" Margin="-6,-4,0,0"
                      Command="{Binding $parent[ScrollViewer].((vm:PokedexPageViewModel)DataContext).ClearSelectionCommand}"
                      ToolTip.Tip="Volta para o resumo da coleção" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Classes="spriteWell" Width="96" Height="96">
                  <Image Source="{Binding Sprite}" Stretch="Uniform" Margin="8" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Number}" Classes="muted" />
                  <!-- Fontes largas (Pokemon GB) quebravam o nome no meio ("Ivysa/ur"): encolhe para caber -->
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Name}" Classes="title" />
                  </Viewbox>
                  <TextBlock Text="{Binding FormName}" Classes="muted" IsVisible="{Binding HasFormName}" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Types}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TypeChip">
                        <Border Classes="chip" Background="{Binding Brush}"><TextBlock Text="{Binding Name}" /></Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding GenerationText}" Classes="muted" FontSize="12" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Image Source="{Binding ShinySprite}" Width="48" Height="48" ToolTip.Tip="Shiny" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Spacing="2">
                <TextBlock Text="CAPTURADA NA POKÉDEX DE" Classes="section" Margin="0" FontSize="10" />
                <TextBlock Text="{Binding CaughtText}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2">
                <TextBlock Text="VISTA EM" Classes="section" Margin="0" FontSize="10" />
                <TextBlock Text="{Binding SeenText}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="6" DataContext="{Binding $parent[ScrollViewer].((vm:PokedexPageViewModel)DataContext)}" x:DataType="vm:PokedexPageViewModel">
                <TextBlock Text="ONDE ESTÃO" Classes="section" Margin="0" FontSize="10" />
                <TextBlock Text="Nenhum Pokémon desta espécie guardado." Classes="muted" FontSize="12" TextWrapping="Wrap"
                           IsVisible="{Binding HasNoLocations}" />
                <ItemsControl ItemsSource="{Binding Locations}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DexLocationViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <TextBlock Text="★" Classes="shiny" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding IsShiny}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Where}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="small" Content="Ir" Command="{Binding GoCommand}" IsVisible="{Binding CanGo}"
                                ToolTip.Tip="Abre este Pokémon no save aberto" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
    </Grid>
    </Grid>
  </DataTemplate>

  <!-- Pagina Encontros -->
  <!-- Pesquisa: todos os Pokemon dos saves abertos, da pasta e do bank -->
  <DataTemplate DataType="vm:SearchPageViewModel">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <Button Content="Pesquisa" Command="{Binding ShowSearchCommand}" />
        <Button Content="Duplicados" Command="{Binding ShowDuplicatesCommand}" ToolTip.Tip="Consultar cópias idênticas e vínculos registrados, sem alterar as fontes." />
        <Button Content="Cancelar leitura" Command="{Binding CancelReadCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Interromper a leitura e descartar o resultado incompleto." />
      </StackPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <StackPanel Spacing="2">
          <TextBlock Text="Pesquisa" Classes="title" />
          <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <Button Classes="small" Content="✕  Limpar filtros" Command="{Binding ClearCommand}" />
          <Button Classes="small" Content="⟳  Atualizar" Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Relê os saves abertos, os saves da pasta e o bank" />
        </StackPanel>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,8">
        <TextBox Text="{Binding Query}" Watermark="Buscar: espécie, apelido, golpe, item, habilidade, treinador... (ex.: garchomp earthquake shiny, #25)" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}" SelectedIndex="{Binding SourceIndex}" MinWidth="200" MaxWidth="300"
                  ToolTip.Tip="Procurar em tudo ou só num save (ou num banco do bank)" />
        <ComboBox Grid.Column="2" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" MinWidth="170" />
      </Grid>
      <WrapPanel DockPanel.Dock="Top" IsVisible="{Binding ShowSearch}" Margin="0,0,0,8" ItemSpacing="8" LineSpacing="8">
        <ComboBox ItemsSource="{Binding ShinyOptions}" SelectedIndex="{Binding ShinyIndex}" MinWidth="130" />
        <ComboBox ItemsSource="{Binding IvOptions}" SelectedIndex="{Binding IvIndex}" MinWidth="150"
                  ToolTip.Tip="IV perfeito = 31 (15 na Gen 1 e 2)" />
        <ComboBox ItemsSource="{Binding NatureOptions}" SelectedIndex="{Binding NatureIndex}" MinWidth="150" MaxDropDownHeight="400" />
        <ComboBox ItemsSource="{Binding BallOptions}" SelectedIndex="{Binding BallIndex}" MinWidth="140" MaxDropDownHeight="400" />
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Nível" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100" Width="120" Watermark="mín." FormatString="0" />
          <TextBlock Text="a" Classes="muted" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100" Width="120" Watermark="máx." FormatString="0" />
        </StackPanel>
        <CheckBox Content="Incluir ovos" IsChecked="{Binding IncludeEggs}" VerticalAlignment="Center" />
      </WrapPanel>
      <Grid DockPanel.Dock="Top" IsVisible="{Binding ShowSearch}" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,10">
        <ItemsControl ItemsSource="{Binding Generations}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GenerationFilterViewModel">
              <Button Classes="small" Classes.accent="{Binding IsActive}" Content="{Binding Label}"
                      ToolTip.Tip="Só Pokémon originários desta geração (clique de novo para mostrar todos)"
                      Command="{Binding $parent[ItemsControl].((vm:SearchPageViewModel)DataContext).SetGenerationCommand}"
                      CommandParameter="{Binding Generation}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
      <Panel IsVisible="{Binding ShowSearch}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <!-- Lista virtualizada: so as linhas visiveis sao montadas -->
          <ItemsRepeater ItemsSource="{Binding Results}">
            <ItemsRepeater.Layout>
              <StackLayout Spacing="6" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:DbResultViewModel">
                <Button Classes="homeRecent searchRow" ToolTip.Tip="{Binding OpenTip}" Margin="0,0,10,0"
                        Command="{Binding $parent[ItemsRepeater].((vm:SearchPageViewModel)DataContext).OpenCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="56,2*,3*,2*" ColumnSpacing="12">
                    <Panel>
                      <Image Source="{Binding Sprite}" Width="56" Height="48" Stretch="Uniform" />
                      <TextBlock Text="★" Classes="shiny" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsShiny}" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding LevelText}" Classes="muted" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding MovesText}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding IvText}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding SourceText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding WhereText}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding OriginText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <TextBlock Text="Lendo saves e bank..." Classes="muted" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <c:EmptyState Art="search" Title="Nenhum Pokémon com esses filtros." Hint="Tente menos filtros ou outra parte do nome." IsVisible="{Binding HasNoResults}" />
      </Panel>
      <Grid IsVisible="{Binding ShowDuplicates}" RowDefinitions="Auto,*">
        <TextBlock Text="{Binding DuplicateSummary}" Classes="muted" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowDuplicateList}">
          <ItemsControl ItemsSource="{Binding DuplicateGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                <Button Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                  <StackPanel Spacing="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Category}" /><TextBlock Text="{Binding Count}" Classes="muted" /></StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <DockPanel Grid.Row="1" IsVisible="{Binding HasDuplicateDetail}">
          <Button DockPanel.Dock="Top" Content="Voltar aos grupos" Command="{Binding BackDuplicatesCommand}" HorizontalAlignment="Left" />
          <ScrollViewer>
            <StackPanel DataContext="{Binding SelectedDuplicate}" x:DataType="vm:DuplicateGroupViewModel" Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Category}" />
              <Button Content="Comparar" Command="{Binding CompareCommand}" IsVisible="{Binding CanCompare}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding HasChildren}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                  <Button Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                    <StackPanel><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding Count}" /></StackPanel>
                  </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Members}" IsVisible="{Binding ShowMembers}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DuplicateMemberViewModel">
                  <Border Classes="card" Margin="0,0,0,6"><Grid ColumnDefinitions="56,*" ColumnSpacing="10">
                    <Image Source="{Binding Sprite}" Width="48" Height="48" />
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Location}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" />
                      <Button Content="Ir ao local" Command="{Binding OpenCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </DockPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:GamePageViewModel">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
        <TextBlock Text="Jogo" Classes="title" />
        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" />
        <TextBlock Text="Este jogo não tem a lista de nomes das flags no PKHeX: elas aparecem só pelo número." Classes="muted" FontSize="12"
                   IsVisible="{Binding NoLabels}" TextWrapping="Wrap" />
      </StackPanel>
      <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10" ItemSpacing="6" LineSpacing="6">
        <Button Classes="small" Classes.accent="{Binding IsFlagsTab}" Content="⚑  Flags de evento" IsVisible="{Binding HasEvents}"
                Command="{Binding SetTabCommand}" CommandParameter="0" ToolTip.Tip="Liga/desliga: itens escondidos já pegos, treinadores vencidos, pontos de voo, eventos da história..." />
        <Button Classes="small" Classes.accent="{Binding IsWorksTab}" Content="#  Valores de evento" IsVisible="{Binding HasWorks}"
                Command="{Binding SetTabCommand}" CommandParameter="1" ToolTip.Tip="Contadores e estados de eventos (ex.: andamento da história, sorteios diários)" />
        <Button Classes="small" Classes.accent="{Binding IsRecordsTab}" Content="🏆  Recordes" IsVisible="{Binding HasRecords}"
                Command="{Binding SetTabCommand}" CommandParameter="2" ToolTip.Tip="Estatísticas do treinador: passos, batalhas, ovos chocados..." />
        <Button Classes="small" Classes.accent="{Binding IsShortcutsTab}" Content="⚡  Atalhos" IsVisible="{Binding HasShortcuts}"
                Command="{Binding SetTabCommand}" CommandParameter="3" ToolTip.Tip="Eventos prontos: liberar lendários, fazer errantes voltarem, áreas do mapa..." />
        <Button Classes="small" Classes.accent="{Binding IsFameTab}" Content="★  Hall da Fama" IsVisible="{Binding HasFame}"
                Command="{Binding SetTabCommand}" CommandParameter="4" ToolTip.Tip="As equipes que venceram a Liga, como o jogo guardou" />
        <Button Classes="small" Classes.accent="{Binding IsCardsTab}" Content="🎁 Cartões" IsVisible="{Binding HasCards}" Command="{Binding SetTabCommand}" CommandParameter="5" />
        <Button Classes="small" Classes.accent="{Binding IsRaidsTab}" Content="⚔ Raids" IsVisible="{Binding HasRaids}" Command="{Binding SetTabCommand}" CommandParameter="6" />
        <Button Classes="small" Classes.accent="{Binding IsClockTab}" Content="⏰ Relógio" IsVisible="{Binding HasClock}" Command="{Binding SetTabCommand}" CommandParameter="7" />
        <Button Classes="small" Classes.accent="{Binding IsRoamersTab}" Content="🗺 Errantes" IsVisible="{Binding HasRoamers}" Command="{Binding SetTabCommand}" CommandParameter="8" />
        <Button Classes="small" Classes.accent="{Binding IsDonutsTab}" Content="🍩 Donuts" IsVisible="{Binding HasDonuts}" Command="{Binding SetTabCommand}" CommandParameter="9" />
        <Button Classes="small" Classes.accent="{Binding IsFashionTab}" Content="👕 Roupas" IsVisible="{Binding HasFashion}" Command="{Binding SetTabCommand}" CommandParameter="10" />
        <Button Classes="small" Classes.accent="{Binding IsFrontierTab}" Content="🏟 Battle Frontier" IsVisible="{Binding HasFrontier}" Command="{Binding SetTabCommand}" CommandParameter="11" />
        <Button Classes="small" Classes.accent="{Binding IsGadgetTab}" Content="{Binding GadgetTabText}" IsVisible="{Binding HasGadget}" Command="{Binding SetTabCommand}" CommandParameter="12" />
        <Button Classes="small" Classes.accent="{Binding IsPokeathlonTab}" Content="🏅 Pokéathlon" IsVisible="{Binding HasPokeathlon}" Command="{Binding SetTabCommand}" CommandParameter="13" />
        <Button Classes="small" Classes.accent="{Binding IsSecretBaseTab}" Content="🏠 Base secreta" IsVisible="{Binding HasSecretBase}" Command="{Binding SetTabCommand}" CommandParameter="14" />
      </WrapPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8" IsVisible="{Binding ShowFilters}">
        <TextBox Text="{Binding Query}" Watermark="Buscar pelo nome ou número (ex.: surf, #120)" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" MinWidth="190"
                  IsVisible="{Binding ShowCategory}" />
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14" Margin="0,0,0,10" IsVisible="{Binding ShowFilters}">
        <CheckBox Content="Mostrar também os sem nome" IsChecked="{Binding ShowUnnamed}" />
        <CheckBox Grid.Column="1" Content="Só os ativados / diferentes de zero" IsChecked="{Binding OnlySet}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsFlagsTab}">
          <Button Classes="small" Content="☑  Ativar mostradas" Command="{Binding SetVisibleCommand}" CommandParameter="1"
                  ToolTip.Tip="Ativa todas as flags que o filtro está mostrando (ex.: categoria Voo = todos os pontos de voo)" />
          <Button Classes="small" Content="☐  Desativar mostradas" Command="{Binding SetVisibleCommand}" CommandParameter="0" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding CountText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      </Grid>
      <TextBlock DockPanel.Dock="Bottom" Text="As alterações valem imediatamente; Salvar grava o arquivo."
                 Classes="muted" FontSize="12" Margin="0,8,0,0" IsVisible="{Binding !IsFameTab}" />
      <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsFlagsTab}">
          <ItemsRepeater ItemsSource="{Binding FlagRows}">
            <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:FlagRowViewModel">
                <Border Classes="card" Padding="10,2" Margin="0,0,10,0">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding IsSet}" MinWidth="0" />
                    <TextBlock Grid.Column="1" Text="{Binding Number}" MinWidth="72" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="3" Text="{Binding Category}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsWorksTab}">
          <ItemsRepeater ItemsSource="{Binding WorkRows}">
            <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkRowViewModel">
                <Border Classes="card" Padding="10,4" Margin="0,0,10,0">
                  <Grid ColumnDefinitions="Auto,*,Auto,190" ColumnSpacing="10">
                    <TextBlock Text="{Binding Number}" MinWidth="72" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" MinWidth="200" MaxWidth="320"
                              IsVisible="{Binding HasOptions}" PlaceholderText="(outro valor)" />
                    <NumericUpDown Grid.Column="3" Value="{Binding ValueNumber}" Minimum="{Binding Min}" Maximum="{Binding Max}" FormatString="0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsRecordsTab}">
          <ItemsRepeater ItemsSource="{Binding RecordRows}">
            <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordRowViewModel">
                <Border Classes="card" Padding="10,4" Margin="0,0,10,0">
                  <Grid ColumnDefinitions="56,*,180" ColumnSpacing="10">
                    <TextBlock Text="{Binding Number}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <NumericUpDown Grid.Column="2" Value="{Binding ValueNumber}" Minimum="0" Maximum="{Binding Max}" FormatString="N0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsShortcutsTab}">
          <ItemsControl ItemsSource="{Binding ShortcutRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShortcutRowViewModel">
                <Border Classes="card" Padding="14,10" Margin="0,0,10,6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                      <TextBlock Text="{Binding State}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                      <Button Classes="small accent" Content="Aplicar" Command="{Binding ApplyCommand}" IsEnabled="{Binding IsReady}"
                              ToolTip.Tip="{Binding Description}" ToolTip.ShowOnDisabled="True" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <DockPanel IsVisible="{Binding IsFameTab}">
          <!-- Hall da Fama: registrar a equipe atual e editar o Pokemon clicado (vale na hora, como as flags) -->
          <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,10,8">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBlock Text="Clique num Pokémon para trocar espécie, apelido e nível. “Usar equipe atual” copia a equipe do save para a vitória." Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="small accent" Content="+  Registrar equipe atual" Command="{Binding RegisterFameCommand}"
                        ToolTip.Tip="Adiciona a equipe atual do save como uma vitória nova no Hall da Fama, como ao vencer a Liga" />
              </Grid>
              <Grid ColumnDefinitions="Auto,200,Auto,160,Auto,80,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasFameSelection}">
                <TextBlock Text="{Binding FameSelectionTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding SpeciesOptions}" Text="{Binding FameSpecies}" FilterMode="ContainsOrdinal"
                                 Watermark="Espécie" MinimumPrefixLength="1" />
                <TextBlock Grid.Column="2" Text="Apelido" VerticalAlignment="Center" IsVisible="{Binding FameHasNickname}" />
                <TextBox Grid.Column="3" Text="{Binding FameNickname}" MaxLength="{Binding FameCaps.NicknameLength}" IsVisible="{Binding FameHasNickname}" />
                <TextBlock Grid.Column="4" Text="Nível" VerticalAlignment="Center" IsVisible="{Binding FameHasNickname}" />
                <NumericUpDown Grid.Column="5" Value="{Binding FameLevel}" Minimum="1" Maximum="100" FormatString="0" IsVisible="{Binding FameHasNickname}" />
                <CheckBox Grid.Column="6" Content="Shiny" IsChecked="{Binding FameShiny}" IsVisible="{Binding FameHasShiny}" />
                <Button Grid.Column="8" Classes="small accent" Content="Aplicar" Command="{Binding ApplyFameCommand}" />
              </Grid>
            </StackPanel>
          </Border>
          <c:EmptyState DockPanel.Dock="Top" Art="trophy" ArtSize="96" Margin="4,16" Title="Hall da Fama vazio"
                        Hint="Nenhuma equipe no Hall da Fama ainda. Use “Registrar equipe atual” para adicionar a equipe do save." IsVisible="{Binding !HasFameTeams}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FameRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FameTeamViewModel">
                  <Border Classes="card" Padding="14,10" Margin="0,0,10,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Date}" Classes="muted" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding !CanEditDate}" />
                        <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding EditDate}" IsVisible="{Binding CanEditDate}" Width="150"
                                            ToolTip.Tip="Data da vitória" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                          <Button Classes="small" Content="Usar equipe atual" Command="{Binding CopyPartyCommand}"
                                  ToolTip.Tip="Troca os Pokémon desta vitória pelos da equipe atual do save" />
                          <Button Classes="small danger" Content="Apagar" Command="{Binding DeleteCommand}"
                                  ToolTip.Tip="Tira esta vitória do Hall da Fama (as seguintes sobem uma posição)" />
                        </StackPanel>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FameMemberViewModel">
                            <Button Classes="ghost fameMember" Classes.selected="{Binding IsSelected}" Width="112" Margin="0,0,6,0" Padding="2,4"
                                    Command="{Binding SelectCommand}" ToolTip.Tip="{Binding Tip}">
                              <StackPanel>
                                <Image Source="{Binding Sprite}" Width="68" Height="56" Stretch="Uniform" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                  <TextBlock Text="★" Classes="muted" FontSize="11" IsVisible="{Binding Shiny}" />
                                  <TextBlock Text="{Binding Level}" Classes="muted" FontSize="11" />
                                </StackPanel>
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
        <DockPanel IsVisible="{Binding IsCardsTab}">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="{Binding CardsNote}" Classes="muted" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="Importar cartão" Command="{Binding ImportCardCommand}" Classes="small" Margin="0,0,6,0" />
              <Button Content="Exportar cartão" Command="{Binding ExportCardCommand}" Classes="small" Margin="0,0,6,0" />
              <Button Content="Apagar cartão" Command="{Binding DeleteCardCommand}" Classes="small danger" Margin="0,0,6,0" />
              <Button Content="Marcar como não recebido" Command="{Binding UnusedCardCommand}" Classes="small" />
              <Button Content="QR" Command="{Binding CardQrCommand}" Classes="small" Margin="6,0,0,0" />
            </WrapPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding CardRows}" SelectedItem="{Binding SelectedCard}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:WonderCardRowViewModel">
                <Grid ColumnDefinitions="68,*" ColumnSpacing="10">
                  <Image Source="{Binding Sprite}" Width="60" Height="48" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <DockPanel IsVisible="{Binding IsRaidsTab}">
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="{Binding RaidsNote}" Classes="muted" TextWrapping="Wrap" />
            <WrapPanel>
              <ComboBox ItemsSource="{Binding RaidRegions}" SelectedItem="{Binding RaidRegion}" MinWidth="190" Margin="0,0,8,0">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RaidRegionViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="Ativar todas" Command="{Binding ActivateRaidsCommand}" Classes="small" Margin="0,0,8,0" />
              <Button Content="Desativar todas" Command="{Binding DeactivateRaidsCommand}" Classes="small" />
            </WrapPanel>
            <StackPanel IsVisible="{Binding RaidRegion.HasSeeds}" Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Seed atual" VerticalAlignment="Center" /><TextBox Text="{Binding RaidRegion.CurrentSeed}" Width="175" MaxLength="18" />
              <TextBlock Text="Seed de amanhã" VerticalAlignment="Center" /><TextBox Text="{Binding RaidRegion.TomorrowSeed}" Width="175" MaxLength="18" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnDefinitions="200,*" ColumnSpacing="16">
            <ListBox ItemsSource="{Binding RaidRegion.Rows}" SelectedItem="{Binding SelectedRaid}" Background="Transparent">
              <ListBox.ItemTemplate><DataTemplate x:DataType="vm:RaidRowViewModel"><StackPanel><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding StarsText}" Classes="muted" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1">
              <ContentControl Content="{Binding SelectedRaid}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:RaidRowViewModel">
                    <StackPanel Spacing="10" Margin="0,0,12,12">
                      <TextBlock Text="{Binding Title}" Classes="title" />
                      <StackPanel IsVisible="{Binding IsSpawn}" Spacing="10">
                        <CheckBox Content="Raid ativa" IsChecked="{Binding Active}" />
                        <TextBlock Text="Tipo de raid" Classes="muted" />
                        <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="Seed (hexadecimal)" Classes="muted" /><TextBox Text="{Binding Seed}" MaxLength="18" />
                        <StackPanel IsVisible="{Binding IsSwsh}" Spacing="10">
                          <TextBlock Text="Hash da tabela (hexadecimal)" Classes="muted" /><TextBox Text="{Binding Hash}" MaxLength="18" />
                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="4"><TextBlock Text="Estrelas" Classes="muted" /><NumericUpDown Value="{Binding Stars}" Minimum="1" Maximum="5" FormatString="0" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Sorteio (1–100)" Classes="muted" /><NumericUpDown Value="{Binding Roll}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
                          </Grid>
                          <CheckBox Content="Watts já coletados" IsChecked="{Binding Watts}" />
                          <CheckBox Content="Flag de evento" IsChecked="{Binding Event}" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsSv}" Spacing="10">
                          <TextBlock Text="{Binding Position}" Classes="muted" TextWrapping="Wrap" />
                          <TextBlock Text="O número de estrelas depende da seed e do progresso; o tipo indica a faixa." Classes="muted" TextWrapping="Wrap" />
                          <CheckBox Content="League Points já coletados" IsChecked="{Binding LeaguePoints}" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding IsSeven}" Spacing="10">
                        <TextBlock Text="Identificador do evento" Classes="muted" /><NumericUpDown Value="{Binding Identifier}" Minimum="0" Maximum="4294967295" FormatString="0" />
                        <CheckBox Content="Capturado" IsChecked="{Binding Captured}" /><CheckBox Content="Derrotado" IsChecked="{Binding Defeated}" />
                        <TextBlock Text="Este registro controla captura e vitória; não ativa um cristal no mapa." Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </ScrollViewer>
          </Grid>
        </DockPanel>
        <ScrollViewer IsVisible="{Binding IsClockTab}">
          <StackPanel Spacing="16">
            <TextBlock Text="{Binding ClockNote}" Classes="muted" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="Corrigir relógio parado" Command="{Binding FixClockCommand}" Classes="small" Margin="0,0,8,0" />
              <Button Content="Avançar 1 dia" Command="{Binding AdvanceClockCommand}" Classes="small" />
            </WrapPanel>
            <ContentControl Content="{Binding InitialClock}" />
            <ContentControl Content="{Binding ElapsedClock}" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsRoamersTab}"><ContentControl Content="{Binding Roamer}" /></ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsDonutsTab}"><ContentControl Content="{Binding Donuts}" /></ScrollViewer>
        <ContentControl IsVisible="{Binding IsFashionTab}" Content="{Binding Fashion}" />
        <ScrollViewer IsVisible="{Binding IsFrontierTab}"><ContentControl Content="{Binding Frontier}" /></ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsGadgetTab}">
          <StackPanel><ContentControl Content="{Binding Poketch}" /><ContentControl Content="{Binding Pokewalker}" /></StackPanel>
        </ScrollViewer>
        <ContentControl IsVisible="{Binding IsPokeathlonTab}" Content="{Binding Pokeathlon}" />
        <ScrollViewer IsVisible="{Binding IsSecretBaseTab}">
          <StackPanel><ContentControl Content="{Binding SecretBase3}" /><ContentControl Content="{Binding SecretBase6}" /></StackPanel>
        </ScrollViewer>
        <TextBlock Text="Nada com esses filtros." Classes="muted" IsVisible="{Binding HasNoRows}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </DockPanel>
  </DataTemplate>

  <!-- Editores por jogo, etapa 4: Battle Frontier, Pokétch/Pokéwalker, Pokéathlon e base secreta -->
  <DataTemplate DataType="vm:FrontierEditorViewModel">
    <StackPanel Spacing="12" Margin="0,0,12,12">
      <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="16">
        <WrapPanel ItemSpacing="18" LineSpacing="10">
          <StackPanel Spacing="4"><TextBlock Text="Battle Points (BP)" Classes="muted" /><NumericUpDown Value="{Binding BP}" Minimum="0" Maximum="9999" FormatString="0" Width="160" /></StackPanel>
          <CheckBox Content="Frontier Pass ativado" IsChecked="{Binding FrontierPass}" IsVisible="{Binding IsGen3}" VerticalAlignment="Bottom" />
        </WrapPanel>
      </Border>
      <Border Classes="card" Padding="16" IsVisible="{Binding IsGen3}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="SÍMBOLOS" Classes="section" Margin="0" /><Button Grid.Column="1" Classes="small" Content="Todos de ouro" Command="{Binding AllGoldCommand}" /></Grid>
          <ItemsControl ItemsSource="{Binding Symbols}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FrontierSymbolViewModel">
              <StackPanel Spacing="4" Margin="0,0,10,8"><TextBlock Text="{Binding Name}" Classes="muted" /><ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding State}" HorizontalAlignment="Stretch" /></StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="16" IsVisible="{Binding HasPrints}">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="IMPRESSÕES" Classes="section" Margin="0" /><Button Grid.Column="1" Classes="small" Content="Todas de ouro" Command="{Binding AllGoldCommand}" /></Grid>
          <ItemsControl ItemsSource="{Binding Prints}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FrontierPrintViewModel">
              <StackPanel Spacing="4" Margin="0,0,10,8"><TextBlock Text="{Binding Name}" Classes="muted" /><ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding State}" HorizontalAlignment="Stretch" /></StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="SEQUÊNCIAS" Classes="section" Margin="0" />
          <WrapPanel ItemSpacing="10" LineSpacing="8">
            <ComboBox ItemsSource="{Binding Facilities}" SelectedIndex="{Binding FacilityIndex}" MinWidth="180" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" MinWidth="160" IsVisible="{Binding HasModes}" />
            <ComboBox ItemsSource="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" MinWidth="140" IsVisible="{Binding HasLevels}" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding Stats}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:FrontierStatViewModel">
              <StackPanel Spacing="4" Margin="0,0,10,0"><TextBlock Text="{Binding Label}" Classes="muted" /><NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="{Binding Max}" FormatString="0" /></StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Série em andamento (o jogo oferece continuar)" IsChecked="{Binding Continue}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:PoketchEditorViewModel">
    <StackPanel Spacing="12" Margin="0,0,12,12">
      <TextBlock Text="Aplicativos do Pokétch. As mudanças valem na hora; Salvar grava o arquivo." Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="small" Content="Liberar todos" Command="{Binding UnlockAllCommand}" />
          </Grid>
          <StackPanel Spacing="4"><TextBlock Text="Aplicativo na tela" Classes="muted" /><ComboBox ItemsSource="{Binding AppNames}" SelectedIndex="{Binding CurrentApp}" MinWidth="260" /></StackPanel>
          <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PoketchAppViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Unlocked}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:PokewalkerEditorViewModel">
    <StackPanel Spacing="12" Margin="0,0,12,12">
      <TextBlock Text="Pokéwalker: watts, passos e rotas liberadas. As mudanças valem na hora; Salvar grava o arquivo." Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <WrapPanel ItemSpacing="18" LineSpacing="10">
            <StackPanel Spacing="4"><TextBlock Text="Watts" Classes="muted" /><NumericUpDown Value="{Binding Watts}" Minimum="0" Maximum="9999" FormatString="0" Width="160" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Passos" Classes="muted" /><NumericUpDown Value="{Binding Steps}" Minimum="0" Maximum="4294967295" FormatString="0" Width="200" /></StackPanel>
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="small" Content="Liberar todas" Command="{Binding UnlockAllCommand}"
                    ToolTip.Tip="Libera as rotas que existem no idioma do save" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Courses}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PokewalkerCourseViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Unlocked}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:PokeathlonMedalsViewModel">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
        <TextBlock Text="Medalhas do Pokéathlon por espécie: uma por percurso. As mudanças valem na hora; Salvar grava o arquivo." Classes="muted" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox Text="{Binding Query}" Watermark="Buscar espécie (nome ou número)" />
          <CheckBox Grid.Column="1" Content="Só incompletas" IsChecked="{Binding OnlyMissing}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="small" Content="Todas as medalhas" Command="{Binding AllCommand}" />
          <Button Grid.Column="3" Classes="small" Content="Tirar todas" Command="{Binding ClearCommand}" />
        </Grid>
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="40,*,80,80,80,80,80,80" Margin="12,0,24,0">
          <TextBlock Grid.Column="2" Text="Speed" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="3" Text="Power" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="4" Text="Skill" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="5" Text="Stamina" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="6" Text="Jump" Classes="muted" HorizontalAlignment="Center" />
          <TextBlock Grid.Column="7" Text="Todas" Classes="muted" HorizontalAlignment="Center" />
        </Grid>
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsRepeater ItemsSource="{Binding Rows}" Margin="0,0,12,0">
          <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="vm:PokeathlonSpeciesViewModel">
              <Border Classes="card" Padding="12,4">
                <Grid ColumnDefinitions="40,*,80,80,80,80,80,80">
                  <Image Source="{Binding Sprite}" Width="36" Height="32" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Number}" Classes="muted" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  </StackPanel>
                  <CheckBox Grid.Column="2" IsChecked="{Binding Speed}" HorizontalAlignment="Center" />
                  <CheckBox Grid.Column="3" IsChecked="{Binding Power}" HorizontalAlignment="Center" />
                  <CheckBox Grid.Column="4" IsChecked="{Binding Skill}" HorizontalAlignment="Center" />
                  <CheckBox Grid.Column="5" IsChecked="{Binding Stamina}" HorizontalAlignment="Center" />
                  <CheckBox Grid.Column="6" IsChecked="{Binding Jump}" HorizontalAlignment="Center" />
                  <CheckBox Grid.Column="7" IsChecked="{Binding All}" HorizontalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:SecretBase3EditorViewModel">
    <Grid ColumnDefinitions="260,*" ColumnSpacing="14" Margin="0,0,12,12">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Bases}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:SecretBase3RowViewModel">
            <StackPanel Spacing="2" Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" /></StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <Border Grid.Column="1" Classes="card" Padding="16" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="10" DataContext="{Binding Selected}" x:DataType="vm:SecretBase3RowViewModel">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="Nome do dono" Classes="muted" /><TextBox Text="{Binding Name}" MaxLength="7" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Gênero" Classes="muted" /><ComboBox ItemsSource="{Binding Genders}" SelectedIndex="{Binding Gender}" HorizontalAlignment="Stretch" /></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <StackPanel Spacing="4"><TextBlock Text="TID" Classes="muted" /><NumericUpDown Value="{Binding TID}" Minimum="0" Maximum="65535" FormatString="0" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="SID" Classes="muted" /><NumericUpDown Value="{Binding SID}" Minimum="0" Maximum="65535" FormatString="0" /></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Visitas" Classes="muted" /><NumericUpDown Value="{Binding TimesEntered}" Minimum="0" Maximum="255" FormatString="0" /></StackPanel>
          </Grid>
          <WrapPanel ItemSpacing="18">
            <CheckBox Content="Já batalhou hoje" IsChecked="{Binding BattledToday}" />
            <CheckBox Content="Registrada" IsChecked="{Binding Registered}" />
          </WrapPanel>
          <TextBlock Text="EQUIPE DA BASE" Classes="section" Margin="0,6,0,0" />
          <TextBlock Text="Sem equipe guardada." Classes="muted" IsVisible="{Binding !HasTeam}" />
          <ItemsControl ItemsSource="{Binding Team}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="vm:SecretBase6EditorViewModel">
    <StackPanel Spacing="12" Margin="0,0,12,12">
      <TextBlock Text="{Binding OwnSummary}" Classes="muted" TextWrapping="Wrap" />
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="SUA BASE" Classes="section" Margin="0" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto">
            <StackPanel Spacing="4" Margin="0,0,0,8"><TextBlock Text="Nome" Classes="muted" /><TextBox Text="{Binding TrainerName}" MaxLength="12" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,0,8"><TextBlock Text="Nome da equipe" Classes="muted" /><TextBox Text="{Binding TeamName}" MaxLength="16" /></StackPanel>
            <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8"><TextBlock Text="Lema" Classes="muted" /><TextBox Text="{Binding TeamSlogan}" MaxLength="16" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="0,0,0,8"><TextBlock Text="Frase de alegria" Classes="muted" /><TextBox Text="{Binding SayHappy}" MaxLength="16" /></StackPanel>
            <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8"><TextBlock Text="Frase de incentivo" Classes="muted" /><TextBox Text="{Binding SayEncourage}" MaxLength="16" /></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4" Margin="0,0,0,8"><TextBlock Text="Frase do quadro" Classes="muted" /><TextBox Text="{Binding SayBlackboard}" MaxLength="16" /></StackPanel>
            <StackPanel Grid.Row="3" Spacing="4"><TextBlock Text="Frase dos confetes" Classes="muted" /><TextBox Text="{Binding SayConfettiBall}" MaxLength="16" /></StackPanel>
          </Grid>
          <WrapPanel ItemSpacing="18" LineSpacing="10">
            <StackPanel Spacing="4"><TextBlock Text="Nível da base" Classes="muted" /><ComboBox ItemsSource="{Binding Ranks}" SelectedIndex="{Binding Rank}" MinWidth="150" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Bandeiras de amigos" Classes="muted" /><NumericUpDown Value="{Binding FlagsFromFriends}" Minimum="0" Maximum="99999" FormatString="0" Width="170" /></StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Bandeiras de outros" Classes="muted" /><NumericUpDown Value="{Binding FlagsFromOthers}" Minimum="0" Maximum="99999" FormatString="0" Width="170" /></StackPanel>
          </WrapPanel>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding GoodsNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="small" Content="Todas as decorações" Command="{Binding GiveAllGoodsCommand}" />
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="BASES DE OUTROS JOGADORES" Classes="section" Margin="0" />
          <TextBlock Text="Nenhuma base de outros jogadores neste save." Classes="muted" IsVisible="{Binding !HasOthers}" />
          <ItemsControl ItemsSource="{Binding Others}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecretBase6OtherViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" /></StackPanel>
                <Button Grid.Column="1" Classes="small danger" Content="Apagar" Command="{Binding DeleteCommand}" />
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:FashionEditorViewModel">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">
        <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding CategoryNames}" SelectedIndex="{Binding CategoryIndex}" HorizontalAlignment="Stretch" />
        <TextBox Text="{Binding Query}" Watermark="Buscar peça por nome ou ID" />
        <WrapPanel ItemSpacing="8" LineSpacing="8"><Button Content="Liberar todas desta categoria" Command="{Binding UnlockCategoryCommand}" /><Button Content="Liberar todas" Command="{Binding UnlockAllCommand}" /></WrapPanel>
        <TextBlock Text="{Binding Count}" Classes="muted" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Rows}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:FashionRowViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Unlocked}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
    </DockPanel>
  </DataTemplate>
  <DataTemplate DataType="vm:DonutPocketViewModel">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Count}" />
      <TextBlock Text="Efeito desejado" Classes="muted" />
      <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Effect}" HorizontalAlignment="Stretch" />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Gerar donut" Command="{Binding GenerateCommand}" />
        <Button Content="Encher com este efeito" Command="{Binding FillCommand}" />
      </WrapPanel>
      <TextBlock Text="Donuts guardados" Classes="muted" />
      <ComboBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" />
      <ContentControl Content="{Binding Draft}" />
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="Aplicar donut" Command="{Binding ApplyCommand}" Classes="accent" />
        <Button Content="Duplicar donut" Command="{Binding DuplicateCommand}" />
        <Button Content="Apagar donut" Command="{Binding DeleteCommand}" />
      </WrapPanel>
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="vm:DonutDraftViewModel">
    <StackPanel Spacing="8">
      <TextBlock Text="Tipo de donut" Classes="muted" />
      <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" HorizontalAlignment="Stretch" />
      <TextBlock Text="Estrelas" Classes="muted" />
      <NumericUpDown Value="{Binding Stars}" Minimum="0" Maximum="5" FormatString="0" />
      <TextBlock Text="{Binding Flavors}" TextWrapping="Wrap" Classes="muted" />
      <ItemsControl ItemsSource="{Binding Berries}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DonutBerryViewModel"><StackPanel Spacing="4" Margin="0,0,0,6"><TextBlock Text="{Binding Name}" Classes="muted" /><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Recalcular estrelas pelas frutas" Command="{Binding RecalculateCommand}" />
      <TextBlock Text="Poderes (até três)" Classes="muted" />
      <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Power1}" HorizontalAlignment="Stretch" />
      <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Power2}" HorizontalAlignment="Stretch" />
      <ComboBox ItemsSource="{Binding Effects}" SelectedItem="{Binding Power3}" HorizontalAlignment="Stretch" />
    </StackPanel>
  </DataTemplate>
  <DataTemplate DataType="vm:RoamerEditorViewModel">
    <StackPanel Spacing="12" Margin="0,0,12,12">
      <TextBlock Text="{Binding Note}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="{Binding IvBugNote}" IsVisible="{Binding HasIvBug}" TextWrapping="Wrap" Classes="muted" />
      <WrapPanel>
        <Button Content="Fazer reaparecer" Command="{Binding ReappearCommand}" Classes="small" Margin="0,0,8,0" />
        <Button Content="Gerar dados legais" Command="{Binding GenerateCommand}" IsVisible="{Binding IsGen3}" Classes="small" Margin="0,0,8,0" />
        <Button Content="Aplicar errante" Command="{Binding ApplyCommand}" IsVisible="{Binding IsGen3}" Classes="small accent" />
      </WrapPanel>
      <Border Classes="card" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Espécie" Classes="muted" /><ComboBox ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding SpeciesName}" HorizontalAlignment="Stretch" />
          <StackPanel IsVisible="{Binding IsGen3}" Spacing="10">
            <CheckBox Content="Errante ativo" IsChecked="{Binding Active}" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <StackPanel Spacing="4"><TextBlock Text="Nível" Classes="muted" /><NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="HP atual" Classes="muted" /><NumericUpDown Value="{Binding Hp}" Minimum="0" Maximum="65535" FormatString="0" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="PID (hexadecimal)" Classes="muted" /><TextBox Text="{Binding Pid}" MaxLength="8" /></StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding IvRows}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RoamerIvViewModel"><StackPanel Spacing="4" Margin="0,0,6,0"><TextBlock Text="{Binding Name}" Classes="muted" /><NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="31" FormatString="0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding CapturedIvs}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel IsVisible="{Binding IsXY}" Spacing="10">
            <TextBlock Text="Estado do errante" Classes="muted" /><ComboBox ItemsSource="{Binding States}" SelectedIndex="{Binding StateIndex}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Número de encontros" Classes="muted" /><NumericUpDown Value="{Binding TimesEncountered}" Minimum="0" Maximum="4294967295" FormatString="0" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <DataTemplate DataType="vm:RtcClockViewModel">
    <Border Classes="card" Padding="16">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
          <StackPanel Spacing="4"><TextBlock Text="Dias" Classes="muted" /><NumericUpDown Value="{Binding Day}" Minimum="0" Maximum="65535" FormatString="0" /></StackPanel>
          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Horas" Classes="muted" /><NumericUpDown Value="{Binding Hour}" Minimum="0" Maximum="23" FormatString="0" /></StackPanel>
          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Minutos" Classes="muted" /><NumericUpDown Value="{Binding Minute}" Minimum="0" Maximum="59" FormatString="0" /></StackPanel>
          <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="Segundos" Classes="muted" /><NumericUpDown Value="{Binding Second}" Minimum="0" Maximum="59" FormatString="0" /></StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </DataTemplate>

  <DataTemplate DataType="vm:BatchPageViewModel">
    <Grid ColumnDefinitions="400,*" ColumnSpacing="16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,10,0">
          <TextBlock Text="{Binding Error}" Classes="legalBad" FontWeight="Normal" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="👁  Pré-visualizar" Command="{Binding PreviewCommand}" />
            <Button Classes="accent" Content="⚙  Aplicar" Command="{Binding ApplyCommand}" />
            <Button Classes="ghost" Content="Limpar" Command="{Binding ClearCommand}" />
          </StackPanel>
        </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,10,0">
          <StackPanel Spacing="2">
            <TextBlock Text="Edição em lote" Classes="title" />
            <TextBlock Text="Altera vários Pokémon do save aberto de uma vez. Pré-visualize antes; Ctrl+Z desfaz." Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="1. QUAIS POKÉMON" Classes="section" Margin="0" />
              <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedIndex="{Binding ScopeIndex}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Selecionados: slots marcados com Ctrl+clique nas caixas. Resultados da Pesquisa: o que a página Pesquisa está mostrando deste save." />
              <CheckBox Content="Incluir ovos" IsChecked="{Binding IncludeEggs}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="4">
              <TextBlock Text="2. O QUE FAZER" Classes="section" Margin="0,0,0,4" />
              <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BatchActionViewModel">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Tip}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="AVANÇADO: SCRIPT DO PKHEX" Classes="section" Margin="0" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Uma instrução por linha. =Prop=valor filtra (! diferente, &gt; maior, &lt; menor); .Prop=valor altera. Linha vazia separa conjuntos. Ex.: =Species=Pikachu, !IsShiny=True, .CurrentLevel=100, .Ball=Poke Ball, .PID=$shiny" />
              <TextBox Text="{Binding Script}" AcceptsReturn="True" MinHeight="110" FontFamily="Consolas,Menlo,monospace" FontSize="13"
                       Watermark="=Species=Pikachu&#x0a;.CurrentLevel=100" TextWrapping="NoWrap" />
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <AutoCompleteBox ItemsSource="{Binding PropertyNames}" Text="{Binding Property}" FilterMode="ContainsOrdinal"
                                 Watermark="Propriedade (ex.: CurrentLevel)" MinimumPrefixLength="1" />
                <Button Grid.Column="1" Classes="small" Content="＝ Filtro" Command="{Binding AddFilterCommand}"
                        ToolTip.Tip="Acrescenta =Propriedade= ao script" />
                <Button Grid.Column="2" Classes="small" Content="✎ Alterar" Command="{Binding AddChangeCommand}"
                        ToolTip.Tip="Acrescenta .Propriedade= ao script" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Column="1">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,10" />
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater ItemsSource="{Binding Preview}">
              <ItemsRepeater.Layout>
                <StackLayout Spacing="6" />
              </ItemsRepeater.Layout>
              <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="vm:BatchChangeViewModel">
                  <Border Classes="card" Padding="10,6" Margin="0,0,10,0">
                    <Grid ColumnDefinitions="56,2*,4*,Auto" ColumnSpacing="12">
                      <Panel>
                        <Image Source="{Binding Sprite}" Width="56" Height="48" Stretch="Uniform" />
                        <TextBlock Text="★" Classes="shiny" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding IsShiny}" />
                      </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Where}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Diff}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Panel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="✓" Classes="legalOk" FontSize="14" IsVisible="{Binding IsLegal}" ToolTip.Tip="Continua legal" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="15" IsVisible="{Binding BecomesIllegal}" ToolTip.Tip="Ficaria ilegal (no modo legal, este é pulado)" />
                      </Panel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
          </ScrollViewer>
          <TextBlock Text="Analisando..." Classes="muted" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </DockPanel>
    </Grid>
  </DataTemplate>

  <DataTemplate DataType="vm:EncounterDbViewModel">
    <UserControl>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
      <StackPanel Spacing="2">
        <TextBlock Text="Encontros" Classes="title" />
        <TextBlock Text="Todos os jeitos de obter uma espécie: selvagem, estático, troca, ovo e eventos." Classes="muted" FontSize="12" />
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="320,Auto,*" ColumnSpacing="12">
        <AutoCompleteBox ItemsSource="{Binding SpeciesNames}" Text="{Binding Species}" FilterMode="ContainsOrdinal"
                         Watermark="Espécie (ex.: Pikachu)" MinimumPrefixLength="1" />
        <CheckBox Grid.Column="1" Content="Só deste jogo" IsChecked="{Binding OnlyThisGame}"
                  ToolTip.Tip="Só encontros possíveis nas versões compatíveis com este save" />
        <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
      <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding HasFilters}">
        <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter}" MinWidth="170" ToolTip.Tip="Tipo do encontro" />
        <ComboBox ItemsSource="{Binding VersionOptions}" SelectedItem="{Binding VersionFilter}" MinWidth="170" ToolTip.Tip="Versão do jogo" />
        <AutoCompleteBox ItemsSource="{Binding MoveNames}" Text="{Binding MoveFilter}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1"
                         Width="220" Watermark="Vem com o golpe..." ToolTip.Tip="Só encontros que já vêm sabendo este golpe" />
        <Button Classes="ghost small" Content="✕ Limpar filtros" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding IsFiltered}" />
      </WrapPanel>
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Content="Mostrar mais" HorizontalAlignment="Center" Command="{Binding ShowMoreCommand}" IsVisible="{Binding HasMore}" />
          </StackPanel>
        </ScrollViewer>
        <ContentControl Grid.Column="1" Content="{Binding Detail}" IsVisible="{Binding HasDetail}" />
      </Grid>
    </Grid>
    </UserControl>
  </DataTemplate>

  <!-- Pagina Eventos (Mystery Gift) -->
  <DataTemplate DataType="vm:GiftDbViewModel">
    <UserControl>
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
      <StackPanel Spacing="2">
        <TextBlock Text="Eventos" Classes="title" />
        <TextBlock Text="Banco de Mystery Gift do PKHeX (eventos oficiais distribuídos)." Classes="muted" FontSize="12" />
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="320,Auto,*" ColumnSpacing="12">
        <TextBox Text="{Binding Search}" Watermark="Buscar por espécie, título ou jogo" />
        <CheckBox Grid.Column="1" Content="Só deste jogo" IsChecked="{Binding OnlyThisGame}"
                  ToolTip.Tip="Só eventos que podem existir neste jogo" />
        <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
      </Grid>
      <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="6" IsVisible="{Binding HasFilters}">
        <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter}" MinWidth="170" ToolTip.Tip="Tipo do encontro" />
        <ComboBox ItemsSource="{Binding VersionOptions}" SelectedItem="{Binding VersionFilter}" MinWidth="170" ToolTip.Tip="Versão do jogo" />
        <AutoCompleteBox ItemsSource="{Binding MoveNames}" Text="{Binding MoveFilter}" FilterMode="ContainsOrdinal" MinimumPrefixLength="1"
                         Width="220" Watermark="Vem com o golpe..." ToolTip.Tip="Só encontros que já vêm sabendo este golpe" />
        <Button Classes="ghost small" Content="✕ Limpar filtros" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding IsFiltered}" />
      </WrapPanel>
      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <ItemsControl ItemsSource="{Binding Results}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel ItemSpacing="10" LineSpacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button Content="Mostrar mais" HorizontalAlignment="Center" Command="{Binding ShowMoreCommand}" IsVisible="{Binding HasMore}" />
          </StackPanel>
        </ScrollViewer>
        <ContentControl Grid.Column="1" Content="{Binding Detail}" IsVisible="{Binding HasDetail}" />
      </Grid>
    </Grid>
    </UserControl>
  </DataTemplate>

  <DataTemplate DataType="vm:PokemonEditorViewModel">
    <v:PokemonEditorView />
  </DataTemplate>

  <!-- Slot da caixa: cartao com sprite grande, nome, nivel e posicao -->
  <DataTemplate DataType="vm:SlotViewModel">
    <Button Classes="slot" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
            Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
            ToolTip.Tip="{Binding Tooltip}"
            Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
            CommandParameter="{Binding}">
      <Panel>
      <c:TypeGlow />
      <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="✓" Classes="markCheck" IsVisible="{Binding IsMarked}" />
            <TextBlock Text="{Binding Position}" Classes="slotPos" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="★" Classes="shiny" IsVisible="{Binding IsShiny}" />
            <TextBlock Text="✓" Classes="legalOk" IsVisible="{Binding IsLegalOk}" ToolTip.Tip="Legal" />
            <TextBlock Text="⚠" Classes="legalBad" IsVisible="{Binding IsLegalBad}" ToolTip.Tip="Ilegal (veja o relatório no editor)" />
          </StackPanel>
        </Grid>
        <Panel Grid.Row="1">
          <Image Source="{Binding Sprite}" Stretch="Uniform" Height="{DynamicResource SlotSpriteSize}" Margin="{DynamicResource SlotSpriteMargin}" />
          <Image Source="{Binding BallSprite}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" ToolTip.Tip="Bola" />
        </Panel>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" IsVisible="{Binding !IsEmpty}">
          <TextBlock Text="{Binding Title}" Classes="slotName" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <TextBlock Text="{Binding Subtitle}" Classes="slotLevel" />
            <TextBlock Text="♂" Classes="male" FontSize="12" IsVisible="{Binding IsMale}" />
            <TextBlock Text="♀" Classes="female" FontSize="12" IsVisible="{Binding IsFemale}" />
          </StackPanel>
        </StackPanel>
      </Grid>
      </Panel>
    </Button>
  </DataTemplate>

  <!-- Caixas -->
  <DataTemplate DataType="vm:BoxesPageViewModel">
    <DockPanel Classes="boxSwipe">
      <DockPanel DockPanel.Dock="Top" Margin="0,4,0,10">
        <Button x:Name="SortButton" DockPanel.Dock="Right" Classes="small" Content="⇅  Ordenar" Margin="10,0,0,0" VerticalAlignment="Top"
                ToolTip.Tip="Ordena a caixa aberta ou todas as caixas (Ctrl+Z desfaz)">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Esta caixa" ItemsSource="{Binding SortOptions}">
                <MenuItem.Styles>
                  <Style Selector="MenuItem MenuItem" x:DataType="vm:SortOptionViewModel">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding SortCurrentCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
              <MenuItem Header="Todas as caixas" ItemsSource="{Binding SortOptions}">
                <MenuItem.Styles>
                  <Style Selector="MenuItem MenuItem" x:DataType="vm:SortOptionViewModel">
                    <Setter Property="Header" Value="{Binding Name}" />
                    <Setter Property="Command" Value="{Binding SortAllCommand}" />
                  </Style>
                </MenuItem.Styles>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      <!-- Espaco do tamanho do Ordenar: as abas ficam centralizadas na pagina; se nao couberem, rolam ate a atual (Controls/CenteredTabs.cs) -->
      <Border x:Name="TabsSpacer" DockPanel.Dock="Left" Width="{Binding #SortButton.Bounds.Width}" Margin="0,0,10,0" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" c:CenteredTabs.Spacer="{Binding #TabsSpacer}">
        <ItemsControl ItemsSource="{Binding BoxTabs}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BoxTabViewModel">
              <Button Classes="boxTab" Classes.current="{Binding IsCurrent}" Command="{Binding GoCommand}"
                      ToolTip.Tip="Ir para esta caixa (durante o arraste, pare em cima para trocar)">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="🔒" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      </DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
        <Button Classes="boxArrow" Content="‹" FontSize="18" Command="{Binding PreviousBoxCommand}"
                ToolTip.Tip="Caixa anterior (arraste um Pokémon até aqui para trocar de caixa)" />
        <!-- Espaco do tamanho do "⋯ Caixa": o titulo fica no centro da pagina, alinhado com as abas -->
        <Border Grid.Column="1" Width="{Binding #BoxMenuButton.Bounds.Width}" />
        <WrapPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" ItemSpacing="10">
          <TextBlock Text="🔒" Classes="title" VerticalAlignment="Center" IsVisible="{Binding IsLocked}" ToolTip.Tip="Caixa travada: destrave em “⋯ Caixa”" />
          <TextBlock Text="{Binding BoxName}" Classes="title" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding BoxLabel}" Classes="muted" VerticalAlignment="Center" />
        </WrapPanel>
        <!-- Acoes da caixa num menu so: o cabecalho cabe numa linha mesmo em 1100 px -->
        <Button x:Name="BoxMenuButton" Grid.Column="3" Classes="small" Content="⋯  Caixa" VerticalAlignment="Center"
                ToolTip.Tip="Renomear, papel de parede, relatório CSV e equipe Showdown desta caixa">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="8" MinWidth="250">
                <Button Classes="small" HorizontalAlignment="Stretch" Content="{Binding LockText}" Command="{Binding ToggleLockCommand}" IsVisible="{Binding CanLock}"
                        ToolTip.Tip="Caixa travada não muda: arrastar, excluir, aplicar, ordenar, colar e edição em lote são recusados até destravar. Fica salvo para este save." />
                <Button Classes="small" HorizontalAlignment="Stretch" Content="✎  Renomear caixa" Command="{Binding RenameCommand}" IsVisible="{Binding CanRename}" />
                <StackPanel Spacing="4" IsVisible="{Binding HasWallpapers}">
                  <TextBlock Text="Papel de parede" Classes="muted" FontSize="12" />
                  <ComboBox ItemsSource="{Binding Wallpapers}" SelectedIndex="{Binding WallpaperIndex}" HorizontalAlignment="Stretch" ToolTip.Tip="Papel de parede da caixa (salvo no jogo)" />
                </StackPanel>
                <Separator />
                <Button Classes="small" HorizontalAlignment="Stretch" Content="⇩  Colar equipe Showdown nos slots vazios" Command="{Binding PasteShowdownCommand}" />
                <Button Classes="small" HorizontalAlignment="Stretch" Content="⇧  Copiar a caixa (Showdown)" Command="{Binding CopyShowdownCommand}" />
                <Button Classes="small" HorizontalAlignment="Stretch" Content="⭳  Exportar relatório (CSV)" Command="{Binding ExportReportCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="4" Classes="boxArrow" Content="›" FontSize="18" Command="{Binding NextBoxCommand}"
                ToolTip.Tip="Próxima caixa (arraste um Pokémon até aqui para trocar de caixa)" />
      </Grid>
      <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,12" MaxWidth="1100"
              IsVisible="{Binding ShowParty}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="EQUIPE" Classes="section" Margin="4,0,12,0" VerticalAlignment="Center" />
          <ItemsControl DataContext="{Binding Party}" ItemsSource="{Binding Slots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SlotViewModel">
                <Button Classes="slot mini" Classes.selected="{Binding IsSelected}" Classes.empty="{Binding IsEmpty}"
                        Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}" ToolTip.Tip="{Binding Tooltip}"
                        Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                        CommandParameter="{Binding}">
                  <Panel>
                  <c:TypeGlow />
                  <Grid ColumnDefinitions="Auto,*">
                    <Image Source="{Binding Sprite}" Stretch="Uniform" Width="44" Height="40" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"
                                IsVisible="{Binding $parent[ItemsControl].Bounds.Width, Converter={x:Static c:WidthAtLeastConverter.Instance}, ConverterParameter=640}">
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" />
                        <TextBlock Text="♂" Classes="male" FontSize="11" IsVisible="{Binding IsMale}" />
                        <TextBlock Text="♀" Classes="female" FontSize="11" IsVisible="{Binding IsFemale}" />
                        <TextBlock Text="⚠" Classes="legalBad" FontSize="11" IsVisible="{Binding IsLegalBad}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  </Panel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="BoxScroll" HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Padding="12" MaxWidth="1100" VerticalAlignment="Top">
          <Grid>
          <Image x:Name="BoxWallpaperImage" Source="{Binding Wallpaper}" Stretch="UniformToFill" Opacity="{Binding WallpaperOpacity}" IsHitTestVisible="False"
                 Height="{Binding #BoxSlots.Bounds.Height}" VerticalAlignment="Top" ClipToBounds="True" />
          <ItemsControl x:Name="BoxSlots" ItemsSource="{Binding Slots}" Classes.fullWallpaper="{Binding IsFullWallpaper}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding #BoxScroll.Bounds.Width, Converter={x:Static c:WidthToColumnsConverter.Instance}, ConverterParameter='112,6'}" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- Caixa vazia: aviso por cima dos slots, sem bloquear o arraste nem o clique -->
          <Border x:Name="EmptyBoxHint" Classes="card" IsVisible="{Binding IsBoxEmpty}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="16,96,16,0" Padding="24,18" Opacity="0.96" BoxShadow="0 8 30 0 #40000000">
            <c:EmptyState Art="box" ArtSize="104" Title="Caixa vazia"
                          Hint="Arraste Pokémon para cá, cole uma equipe Showdown em “⋯ Caixa” ou clique num slot para criar um Pokémon." MaxWidth="380" />
          </Border>
          </Grid>
        </Border>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- Equipe -->
  <DataTemplate DataType="vm:PartyPageViewModel">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,16">
        <TextBlock Text="Equipe" Classes="title" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="🖼 Vitrine" VerticalAlignment="Center" Command="{Binding ShowcaseCommand}"
                ToolTip.Tip="Mostra a equipe grande, com tipos, item, habilidade e golpes, e salva como imagem para compartilhar" />
        <Button Grid.Column="2" Content="📋 Showdown" VerticalAlignment="Center" ToolTip.Tip="Colar uma equipe Showdown nas vagas da equipe, ou copiar a equipe inteira no formato Showdown">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="⇩ Colar equipe nas vagas" Command="{Binding PasteShowdownCommand}" />
              <MenuItem Header="⇧ Copiar a equipe (Showdown)" Command="{Binding CopyShowdownCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <ScrollViewer x:Name="PartyScroll" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
      <ItemsControl ItemsSource="{Binding Slots}" VerticalAlignment="Top" MaxWidth="1100" HorizontalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding #PartyScroll.Bounds.Width, Converter={x:Static c:WidthToColumnsConverter.Instance}, ConverterParameter='300,3'}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SlotViewModel">
            <Button Classes="partyCard" HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Tooltip}" Classes.selected="{Binding IsSelected}" Classes.dropTarget="{Binding IsDropTarget}" Classes.match="{Binding IsMatch}" Classes.dimmed="{Binding IsDimmed}" Classes.marked="{Binding IsMarked}"
                    Command="{Binding $parent[ItemsControl].((vm:SlotPageViewModel)DataContext).SelectSlotCommand}"
                    CommandParameter="{Binding}">
              <Panel>
              <c:TypeGlow />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="spriteWell">
                  <Image Source="{Binding Sprite}" Width="104" Height="92" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="2">
                  <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="20" />
                  </Viewbox>
                  <TextBlock Text="{Binding Nickname}" Classes="muted" IsVisible="{Binding HasNickname}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="15" />
                    <TextBlock Text="♂" Classes="male" FontSize="15" IsVisible="{Binding IsMale}" />
                    <TextBlock Text="♀" Classes="female" FontSize="15" IsVisible="{Binding IsFemale}" />
                  </StackPanel>
                  <TextBlock Text="★ Shiny" Classes="shiny" IsVisible="{Binding IsShiny}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Top" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Position}" Classes="slotPos" FontSize="16" HorizontalAlignment="Right" />
                  <TextBlock Text="✓" Classes="legalOk" FontSize="14" HorizontalAlignment="Right" IsVisible="{Binding IsLegalOk}" ToolTip.Tip="Legal" />
                  <TextBlock Text="⚠" Classes="legalBad" FontSize="15" HorizontalAlignment="Right" IsVisible="{Binding IsLegalBad}" ToolTip.Tip="Ilegal" />
                </StackPanel>
              </Grid>
              </Panel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="card" IsVisible="{Binding HasDaycare}">
        <StackPanel Spacing="10">
          <TextBlock Text="🥚 Creche" Classes="section" />
          <TextBlock Text="Clique para editar. Para pôr na creche, selecione antes um Pokémon das caixas ou da equipe." Classes="muted" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding DaycareAreas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DaycareAreaViewModel">
                <StackPanel Spacing="8" Margin="0,0,0,12">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <CheckBox Content="Ovo esperando na creche" IsChecked="{Binding EggAvailable}" IsVisible="{Binding HasEgg}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSeed}">
                    <TextBlock Text="Seed do ovo" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Seed, UpdateSourceTrigger=LostFocus}" Width="260" MaxLength="32" FontFamily="Consolas,monospace" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DaycareSlotViewModel">
                        <Border Classes="card" Width="230" Margin="0,0,8,8">
                          <StackPanel Spacing="6">
                            <Button Command="{Binding EditCommand}" HorizontalContentAlignment="Stretch">
                              <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                <Image Source="{Binding Sprite}" Width="60" Height="48" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding Level}" Classes="muted" />
                                </StackPanel>
                              </Grid>
                            </Button>
                            <StackPanel IsVisible="{Binding HasExperience}">
                              <TextBlock Text="Experiência na creche" Classes="muted" FontSize="12" />
                              <NumericUpDown Value="{Binding Experience}" Minimum="0" Maximum="4294967295" FormatString="0" />
                            </StackPanel>
                            <Button Content="Pôr na creche" Command="{Binding DepositCommand}" IsVisible="{Binding !Occupied}" Classes="small" />
                            <Button Content="Tirar da creche" Command="{Binding WithdrawCommand}" IsVisible="{Binding Occupied}" Classes="small" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </DataTemplate>

  <!-- Treinador -->
  <DataTemplate DataType="vm:TrainerPageViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="4" Margin="0,0,12,12">
      <TextBlock Text="Treinador" Classes="title" Margin="0,0,0,8" />
      <Border Classes="card">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Game}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Generation}" Classes="muted" />
          <TextBlock Text="{Binding Checksum, StringFormat='Checksums: {0}'}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <TextBlock Text="IDENTIDADE" Classes="section" />
      <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="Nome (OT)" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding OT}" />
        <TextBlock Grid.Row="1" Text="TID" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="4294967295" FormatString="0" Value="{Binding TID}" />
        <TextBlock Grid.Row="2" Text="SID" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4294967295" FormatString="0" Value="{Binding SID}" />
        <TextBlock Grid.Row="3" Text="Dinheiro" VerticalAlignment="Center" />
        <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="{Binding MaxMoney}" FormatString="N0" Value="{Binding Money}" />
      </Grid>
      <Grid ColumnDefinitions="140,*" Margin="0,8,0,0" IsVisible="{Binding HasGender}">
        <TextBlock Text="Gênero" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Genders}" SelectedIndex="{Binding GenderIndex}" HorizontalAlignment="Stretch" />
      </Grid>
      <StackPanel IsVisible="{Binding HasCurrency}" Spacing="8">
        <TextBlock Text="MOEDAS E BP" Classes="section" />
        <Grid ColumnDefinitions="140,*" IsVisible="{Binding HasCoins}">
          <TextBlock Text="Moedas" VerticalAlignment="Center" ToolTip.Tip="Fichas do Game Corner" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="{Binding MaxCoins}" FormatString="N0" Value="{Binding Coins}" />
        </Grid>
        <Grid ColumnDefinitions="140,*" IsVisible="{Binding HasBP}">
          <TextBlock Text="Battle Points (BP)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Column="1" Minimum="0" Maximum="9999" FormatString="0" Value="{Binding BP}" />
        </Grid>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasBadges}" Spacing="8">
        <TextBlock Text="INSÍGNIAS" Classes="section" />
        <ItemsControl ItemsSource="{Binding BadgeGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BadgeGroupViewModel">
              <Border Classes="card" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Region}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Summary}" Classes="muted" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="small" Content="Todas" Command="{Binding AllCommand}" />
                    <Button Grid.Column="2" Classes="small" Content="Nenhuma" Command="{Binding NoneCommand}" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Badges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:BadgeViewModel"><CheckBox Content="{Binding Name}" IsChecked="{Binding Has}" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <StackPanel IsVisible="{Binding HasDates}" Spacing="8">
        <TextBlock Text="DATAS" Classes="section" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Text="Início da aventura" VerticalAlignment="Center" />
          <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding AdventureStart}" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Row="1" Text="Hall da Fama" VerticalAlignment="Center" />
          <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding FameDate}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>
      <TextBlock Text="TEMPO DE JOGO" Classes="section" />
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
        <NumericUpDown Minimum="0" Maximum="65535" FormatString="0" Value="{Binding Hours}" ToolTip.Tip="Horas" />
        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="59" FormatString="0" Value="{Binding Minutes}" ToolTip.Tip="Minutos" />
        <NumericUpDown Grid.Column="2" Minimum="0" Maximum="59" FormatString="0" Value="{Binding Seconds}" ToolTip.Tip="Segundos" />
      </Grid>
      <TextBlock Text="As alterações valem imediatamente; Salvar grava o arquivo."
                 Classes="muted" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
    </ScrollViewer>
  </DataTemplate>

  <!-- Ajuda: funcoes, novidades e sobre -->
  <DataTemplate DataType="vm:HelpPageViewModel">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <StackPanel Spacing="2">
          <TextBlock Text="Ajuda" Classes="title" />
          <TextBlock Text="{Binding VersionText, StringFormat='PKHeX Modern · {0}'}" Classes="muted" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
          <Button Classes="accent small" Content="{Binding RestartText}" Command="{Binding RestartCommand}" IsVisible="{Binding IsReadyToRestart}" />
          <Button Classes="small" Content="‹  Voltar" Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).CloseHelpCommand}"
                  ToolTip.Tip="Volta para onde você estava (Esc)" />
        </StackPanel>
      </Grid>
      <TabControl Classes="editorTabs" SelectedIndex="{Binding SelectedTab}">
        <TabItem Header="Funções">
          <DockPanel Margin="0,12,0,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" Watermark="🔍  Procurar uma função (ex.: bank, shiny, legalizar)"
                     MaxWidth="920" HorizontalAlignment="Left" Width="920" Margin="0,0,0,12" />
            <TextBlock DockPanel.Dock="Top" Text="Nenhuma função encontrada." Classes="muted" IsVisible="{Binding HasNoResults}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Sections}" MaxWidth="920" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:HelpSection">
                    <Border Classes="card" Margin="0,0,0,12">
                      <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:HelpItem">
                              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                  <!-- Leitura: mais contraste que o cinza "muted", linhas de ~90 caracteres e mais espaco entre linhas -->
                                  <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" LineHeight="20" MaxWidth="760" HorizontalAlignment="Left" Opacity="0.82" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="chip" Background="{DynamicResource CardBorder}" VerticalAlignment="Top"
                                        IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                  <TextBlock Text="{Binding Shortcut}" />
                                </Border>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Novidades">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding ShowChangelogLanguageNote}" Text="As notas de versão são escritas em português." />
            <ScrollViewer Margin="0,12,0,0">
              <ItemsControl ItemsSource="{Binding Changelog}" MaxWidth="920" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="svc:ChangelogVersion">
                    <Border Classes="card" Margin="0,0,0,12">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                          <TextBlock Text="{Binding Date}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                        </StackPanel>
                        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" IsVisible="{Binding Intro, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ItemsControl ItemsSource="{Binding Sections}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:ChangelogSection">
                              <StackPanel Spacing="4" Margin="0,4,0,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Items}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <Grid ColumnDefinitions="16,*" Margin="4,1">
                                        <TextBlock Text="•" Classes="muted" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="13" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Sobre">
          <ScrollViewer Margin="0,12,0,0">
            <StackPanel Spacing="12" MaxWidth="920" HorizontalAlignment="Left">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="PKHeX Modern" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="{Binding VersionText}" Classes="muted" />
                  <Button Classes="small" Content="{Binding DiagnosticButtonText}" Command="{Binding DiagnosticCommand}" />
                  <TextBlock TextWrapping="Wrap" Text="Interface em português para o PKHeX, feita por Carlos Mozart. Por baixo é o mesmo PKHeX.Core (de Kaphotics e colaboradores), com as mesmas regras de save, legalidade e encontros." />
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="small" Content="🔗  Código no GitHub" Command="{Binding OpenRepoCommand}" />
                    <Button Classes="small" Content="📦  Todas as versões" Command="{Binding OpenReleasesCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="ATUALIZAÇÕES" Classes="section" Margin="0" />
                  <TextBlock Text="{Binding UpdateText}" TextWrapping="Wrap" />
                  <StackPanel Spacing="4" IsVisible="{Binding IsDownloading}">
                    <TextBlock Text="{Binding DownloadText}" Classes="muted" FontSize="12" />
                    <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="6" />
                  </StackPanel>
                  <WrapPanel ItemSpacing="6" LineSpacing="6">
                    <Button Classes="small" Content="⟳  Verificar agora" Command="{Binding CheckUpdatesCommand}" />
                    <Button Classes="small" Content="✨  Ver animação" Command="{Binding DemoAnimationCommand}"
                            ToolTip.Tip="Mostra a animação da atualização com um progresso de mentira (nada é baixado)" />
                    <Button Classes="accent small" Content="⬇  Atualizar agora" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding ShowInstallButton}" />
                    <Button Classes="accent small" Content="{Binding RestartText}" Command="{Binding RestartCommand}" IsVisible="{Binding IsReadyToRestart}" />
                    <Button Classes="small" Content="{Binding LatestButtonText}" Command="{Binding OpenLatestCommand}" IsVisible="{Binding ShowLinkBanner}"
                            ToolTip.Tip="Mostra as novidades antes de abrir o download" />
                  </WrapPanel>
                  <CheckBox Content="Verificar se saiu uma versão nova ao abrir o app" FontSize="12" IsChecked="{Binding CheckOnStartup}" />
                  <CheckBox Content="Mostrar novidades e oferecer atualização ao encontrar uma versão nova" FontSize="12" IsChecked="{Binding AutoUpdate}"
                            IsEnabled="{Binding CheckOnStartup}" />
                  <TextBlock Text="Rodando pelo código-fonte: a atualização automática só funciona no PKHeX.Modern.exe baixado da release."
                             Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding !CanSelfUpdate}" />
                </StackPanel>
              </Border>
              <Border Classes="card wikiCard">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                  <TextBlock Text="📚" FontSize="34" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="CONHEÇA TAMBÉM" Classes="section" Margin="0" />
                    <TextBlock Text="AllGenWiki" FontSize="18" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" Text="Meu outro projeto: uma enciclopédia Pokémon em português das nove gerações, de Red/Blue a Scarlet/Violet, Legends: Z-A e Pokémon Champions. Pokédex por jogo, movesets, TMs, treinadores, mapas, encontros, roteiros e guias, montador de equipes com análise de fraquezas e compatibilidade do Pokémon HOME. Funciona offline e pode ser instalada como app." />
                    <WrapPanel ItemSpacing="6" LineSpacing="6">
                      <Button Classes="accent small" Content="🌐  Abrir o AllGenWiki" Command="{Binding OpenWikiCommand}" ToolTip.Tip="{Binding WikiUrl}" />
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DataTemplate>

  <!-- Mochila -->
  <DataTemplate DataType="vm:BagPageViewModel">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="Mochila" Classes="title" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="◎  Encher bolso ▾" ToolTip.Tip="Conjuntos prontos: põe todos os itens do tipo, com 99 de cada e em ordem numérica, sem tirar o que já está lá">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Todos os TMs" Command="{Binding GiveAllTMsCommand}"
                          ToolTip.Tip="Põe todos os TMs do jogo no bolso de TMs, com 99 de cada, sem tirar o que já está lá (HMs e TRs do mesmo bolso também entram)" />
                <MenuItem Header="Todas as Poké Balls" Command="{Binding GiveAllBallsCommand}" />
                <MenuItem Header="Todos os remédios" Command="{Binding GiveAllMedicineCommand}"
                          ToolTip.Tip="Poções, curas de status, Revives, PP e vitaminas do bolso de remédios (Gen 4 em diante)" />
                <MenuItem Header="Todas as berries" Command="{Binding GiveAllBerriesCommand}" />
                <Separator />
                <MenuItem Header="Tudo no bolso aberto" Command="{Binding FillCurrentPouchCommand}"
                          ToolTip.Tip="Todos os itens que o jogo aceita no bolso aberto, até onde couber. Itens-chave ficam de fora, porque mexem no andamento do jogo." />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="accent" Content="Aplicar mochila" Command="{Binding SaveCommand}" ToolTip.Tip="Leva os itens da tela para o save aberto; Salvar grava o arquivo" />
        </StackPanel>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
      <ListBox Classes="tabs" ItemsSource="{Binding Pouches}" SelectedItem="{Binding SelectedPouch}"
               Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PouchViewModel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <TextBlock Text="{Binding SelectedPouch.FreeText}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
          <CheckBox Content="Mostrar todas as vagas" IsChecked="{Binding ShowEmptySlots}"
                    ToolTip.Tip="Sem marcar, a mochila mostra os itens que você tem e algumas vagas livres para adicionar" />
        </StackPanel>
      </Grid>
      <!-- Itens em colunas, em linhas virtualizadas: so as linhas visiveis sao criadas (bolsos de ate ~260 slots) -->
      <Panel x:Name="BagArea">
        <ListBox Classes="plainRows" Background="Transparent">
          <ListBox.ItemsSource>
            <MultiBinding Converter="{x:Static c:ChunkRowsConverter.Instance}" ConverterParameter="330,4">
              <Binding Path="SelectedPouch.VisibleItems" />
              <Binding ElementName="BagArea" Path="Bounds.Width" />
            </MultiBinding>
          </ListBox.ItemsSource>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:GridRow">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding $parent[ItemsControl].((c:GridRow)DataContext).Columns}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BagItemViewModel">
                      <Border Classes="bagItem" Classes.empty="{Binding IsEmptySlot}" ToolTip.Tip="{Binding Tip}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Classes="bagIcon">
                            <Image Source="{Binding Icon}" Width="32" Height="32" />
                          </Border>
                          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ItemsSource="{Binding Options}"
                                    SelectedItem="{Binding Selected}" IsEnabled="{Binding IsEditable}">
                            <ComboBox.SelectionBoxItemTemplate>
                              <DataTemplate x:DataType="vm:ItemOption">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              </DataTemplate>
                            </ComboBox.SelectionBoxItemTemplate>
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:ItemOption">
                                <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent" ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right">
                                  <Image Source="{Binding Icon}" Width="22" Height="22" />
                                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <NumericUpDown Grid.Column="2" Width="112" Minimum="0" FormatString="0" Value="{Binding Count}"
                                         VerticalAlignment="Center" ToolTip.Tip="Quantidade" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>
  </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://PKHeX.Modern.UI/Theme/Styles.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PKHeX.Modern.UI/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
